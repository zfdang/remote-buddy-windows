<Window x:Class="RemoteBuddy.App.Views.CommonPhraseOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen">
    <Border Width="310" CornerRadius="20" Background="#EE1B1D22" BorderBrush="#38FFFFFF" BorderThickness="1" Padding="14">
        <StackPanel>
            <!-- Top Hint + Close -->
            <Grid Margin="0,0,0,10">
                <TextBlock Text="按对应遥控器按键插入常用语&#x0a;按返回键或语音键取消"
                           FontSize="12.5" Foreground="#E6FFFFFF" TextAlignment="Center" HorizontalAlignment="Center" LineHeight="18"/>
                <Button Content="✕" Width="26" Height="26" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="Transparent" BorderBrush="Transparent" Foreground="#B3FFFFFF"
                        Click="OnCloseClick"/>
            </Grid>

            <!-- Native Keyboard Notice (Xiaomi / T1) -->
            <TextBlock x:Name="NativeKeysNotice"
                       Text="方向键与 OK 保留系统原生输入，请按下方按键插入常用语"
                       FontSize="12" Foreground="#A9D7FF" TextAlignment="Center" TextWrapping="Wrap"
                       Margin="0,0,0,8" Visibility="Collapsed"/>

            <!-- Circular D-Pad -->
            <Border x:Name="DpadBorder" Width="252" Height="252" CornerRadius="126" Background="#FF24272D" BorderBrush="#38FFFFFF" BorderThickness="1" HorizontalAlignment="Center">
                <Grid>
                    <Button x:Name="BtnUp" HorizontalAlignment="Center" VerticalAlignment="Top" Width="110" Height="62" Margin="0,8,0,0"
                            Background="Transparent" BorderBrush="Transparent" Foreground="#FFFFFF" Click="OnButtonClick">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="▲" FontSize="13" Foreground="#A6ADB9" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="LabelUp" Text="未分配" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="98" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnDown" HorizontalAlignment="Center" VerticalAlignment="Bottom" Width="110" Height="62" Margin="0,0,0,8"
                            Background="Transparent" BorderBrush="Transparent" Foreground="#FFFFFF" Click="OnButtonClick">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock x:Name="LabelDown" Text="未分配" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="98" HorizontalAlignment="Center"/>
                            <TextBlock Text="▼" FontSize="13" Foreground="#A6ADB9" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnLeft" HorizontalAlignment="Left" VerticalAlignment="Center" Width="68" Height="88" Margin="8,0,0,0"
                            Background="Transparent" BorderBrush="Transparent" Foreground="#FFFFFF" Click="OnButtonClick">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="◀" FontSize="13" Foreground="#A6ADB9" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="LabelLeft" Text="未分配" FontSize="11.5" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="60"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnRight" HorizontalAlignment="Right" VerticalAlignment="Center" Width="68" Height="88" Margin="0,0,8,0"
                            Background="Transparent" BorderBrush="Transparent" Foreground="#FFFFFF" Click="OnButtonClick">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="▶" FontSize="13" Foreground="#A6ADB9" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="LabelRight" Text="未分配" FontSize="11.5" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="60"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnOk" HorizontalAlignment="Center" VerticalAlignment="Center" Width="92" Height="92" Click="OnButtonClick">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="46" Background="#FF2E323B" BorderBrush="#66000000" BorderThickness="1">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="OK" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="LabelOk" Text="未分配" FontSize="12" Foreground="#D9FFFFFF" TextTrimming="CharacterEllipsis" MaxWidth="78" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Extra Model Buttons -->
            <StackPanel x:Name="ExtraRowsPanel" Margin="0,12,0,0"/>
        </StackPanel>
    </Border>
</Window>
