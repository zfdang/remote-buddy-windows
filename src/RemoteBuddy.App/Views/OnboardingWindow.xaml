<Window x:Class="RemoteBuddy.App.Views.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:RemoteBuddy.App.ViewModels"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="600" Width="800"
        Icon="/Resources/app.ico"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource PrimaryBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Stepper -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="0,0,0,14" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <TextBlock Text="{Binding StepTitle}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding StepProgressText}" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Step Content Area (Dynamic Step Visibility) -->
        <Grid Grid.Row="1" Margin="10,0">
            <!-- Step 1: Welcome & Language -->
            <StackPanel x:Name="Step1Panel" Visibility="Visible">
                <TextBlock Text="欢迎使用 Remote Buddy（遥控搭子）" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,10"/>
                <TextBlock Text="本向导将引导您完成虚拟音频驱动检查、蓝牙遥控器连接与目标输入法快捷键配置。" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,24"/>
                
                <TextBlock Text="界面显示语言：" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,8"/>
                <TextBlock Text="简体中文 (当前版本优先支持中文界面)" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,24"/>
            </StackPanel>

            <!-- Step 2: Virtual Audio Driver Check -->
            <StackPanel x:Name="Step2Panel" Visibility="Collapsed">
                <TextBlock Text="检查虚拟麦克风驱动 (VB-CABLE)" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,10"/>
                <TextBlock Text="Remote Buddy 需要通过虚拟音频线路（CABLE Input / Output）将遥控器声音无缝送入微信输入法或豆包中。" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                
                <Border Background="{StaticResource CardBackgroundBrush}" Padding="16" CornerRadius="6" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{Binding DriverStatusMessage}" FontSize="14" Foreground="#FFF" TextWrapping="Wrap" Margin="0,0,0,14"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="🔄 重新检测" Margin="0,0,10,0" Padding="14,6" Background="#007ACC" Command="{Binding RefreshDriverStatusCommand}"/>
                            <Button Content="安装 VB-CABLE" Padding="14,6" Command="{Binding InstallCableCommand}"
                                    Visibility="{Binding CanInstallCable, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding CableInstallMessage}" Margin="0,10,0,0" TextWrapping="Wrap"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Visibility="{Binding CableInstallMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Step 3: Remote Pairing & Connection -->
            <StackPanel x:Name="Step3Panel" Visibility="Collapsed">
                <DockPanel Margin="0,0,0,10">
                    <TextBlock Text="选择并连接您的遥控器" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                    <Button Content="{Binding IsScanning, Converter={StaticResource BoolToScanTextConverter}, FallbackValue='🔍 扫描设备'}" HorizontalAlignment="Right" Padding="10,4" Background="#007ACC" Command="{Binding ToggleScanCommand}"/>
                </DockPanel>
                <TextBlock Text="点击“扫描设备”查找已配对及正在广播的遥控器，再点击“连接”建立语音服务。已在 Windows 蓝牙设置中连接的遥控器无需重新配对。" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                <ScrollViewer Height="180" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding DiscoveredDevices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CardBackgroundBrush}" Margin="0,0,0,6" Padding="10" CornerRadius="4">
                                    <DockPanel LastChildFill="False">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#FFF" VerticalAlignment="Center"/>
                                        <Button Content="连接" DockPanel.Dock="Right" Width="70"
                                                Command="{Binding DataContext.ConnectDeviceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Text="连接状态：" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,10,0,4"/>
                <TextBlock Text="{Binding DeviceConnectionStatus}" TextWrapping="Wrap" Foreground="#00CC66"/>

                <!-- Pairing Tips Callout -->
                <Border Background="#1A1D20" BorderBrush="#333740" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="💡 首次配对提示（长按组合键进入蓝牙配对模式）：" FontSize="11" FontWeight="SemiBold" Foreground="#88CCFF" Margin="0,0,0,4"/>
                        <TextBlock Text="• 小米遥控器：靠近电脑，同时长按【主页】+【菜单】键约 3 秒直至指示灯闪烁" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                        <TextBlock Text="• Google G9N9N：靠近电脑，同时长按【返回】+【主页】键约 3 秒直至底部白灯闪烁" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                        <TextBlock Text="• T1 飞鼠遥控器：靠近电脑，同时长按【主页】+【返回】键直至指示灯慢闪配对" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Step 4: Button Test -->
            <StackPanel x:Name="Step4Panel" Visibility="Collapsed">
                <TextBlock Text="遥控器按键响应测试" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,10"/>
                <TextBlock Text="请按方向键或 OK，查看普通按键是否响应。仅识别到语音键时，也可以继续测试麦克风。" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,16"/>
                <Border Background="{StaticResource CardBackgroundBrush}" Padding="20" CornerRadius="6" HorizontalAlignment="Left" MinWidth="300">
                    <TextBlock Text="{Binding LastPressedButtonName}" FontSize="18" FontWeight="Bold" Foreground="#00CC66" HorizontalAlignment="Center"/>
                </Border>
                <Border Visibility="{Binding TruncationWarningVisibility}" Background="#2B1D00" BorderBrush="#FF9900" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,12,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                                <Button Content="⚡ 重启蓝牙适配器"
                                        Command="{Binding RestartBluetoothAdapterCommand}"
                                        IsEnabled="{Binding CanRestartBluetooth}"
                                        Padding="14,6" Margin="0,0,8,0" Background="#E67E22" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
                                <Button Content="打开设备管理器"
                                        Command="{Binding OpenDeviceManagerCommand}"
                                        Padding="10,6" Background="#3E3E42" Foreground="#CCC" Cursor="Hand"
                                        ToolTip="打开 Windows 设备管理器，可手动对 Bluetooth 适配器右键禁用再启用"/>
                            </StackPanel>
                            <TextBlock Text="{Binding TruncationWarningMessage}" Foreground="#FFCC66" TextWrapping="Wrap" FontSize="13" LineHeight="18" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Grid.Row="1" Text="{Binding RestartBluetoothStatusText}" Foreground="#00E676" FontSize="12" Margin="0,8,0,0"
                                   Visibility="{Binding RestartBluetoothStatusVisibility}" TextWrapping="Wrap"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Step 5: Voice & VU Meter Test -->
            <StackPanel x:Name="Step5Panel" Visibility="Collapsed">
                <TextBlock Text="麦克风拾音与动态波形测试" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,10"/>
                <TextBlock Text="按住遥控器语音键说话，观察下方电平指示条是否跟随声音跳动：" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,20"/>
                <ProgressBar Value="{Binding LiveAudioLevel}" Minimum="0" Maximum="1" Height="14" Background="#111" Foreground="#00CC66" BorderThickness="0" Margin="0,0,0,16"/>
                <TextBlock Text="（若音量条有跳动，说明音频流与 ADPCM 解码工作正常）" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"/>
            </StackPanel>

            <!-- Step 6: IME Tool Configuration -->
            <StackPanel x:Name="Step6Panel" Visibility="Collapsed">
                <TextBlock Text="配置目标语音输入工具" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,10"/>
                <TextBlock Text="选择语音输入工具，然后确认两边的快捷键一致。" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                <WrapPanel Margin="0,0,0,14">
                    <Button Content="微信输入法" Margin="0,0,8,8" Command="{Binding ApplyPresetCommand}" CommandParameter="WeChatInput"
                            Background="{Binding SelectedTool, Converter={StaticResource EqualValueToBrushConverter}, ConverterParameter=WeChatInput}"/>
                    <Button Content="豆包输入法" Margin="0,0,8,8" Command="{Binding ApplyPresetCommand}" CommandParameter="DoubaoInput"
                            Background="{Binding SelectedTool, Converter={StaticResource EqualValueToBrushConverter}, ConverterParameter=DoubaoInput}"/>
                    <Button Content="腾讯 Chatterfly" Margin="0,0,8,8" Command="{Binding ApplyPresetCommand}" CommandParameter="Chatterfly"
                            Background="{Binding SelectedTool, Converter={StaticResource EqualValueToBrushConverter}, ConverterParameter=Chatterfly}"/>
                    <Button Content="Typeless" Margin="0,0,8,8" Command="{Binding ApplyPresetCommand}" CommandParameter="Typeless"
                            Background="{Binding SelectedTool, Converter={StaticResource EqualValueToBrushConverter}, ConverterParameter=Typeless}"/>
                    <Button Content="Windows 听写 (Win+H)" Margin="0,0,8,8" Command="{Binding ApplyPresetCommand}" CommandParameter="WindowsDictation"
                            Background="{Binding SelectedTool, Converter={StaticResource EqualValueToBrushConverter}, ConverterParameter=WindowsDictation}"/>
                    <Button Content="其他语音工具" Margin="0,0,8,8" Command="{Binding ApplyPresetCommand}" CommandParameter="Custom"
                            Background="{Binding SelectedTool, Converter={StaticResource EqualValueToBrushConverter}, ConverterParameter=Custom}"/>
                </WrapPanel>

                <Border Background="{StaticResource CardBackgroundBrush}" Padding="14" CornerRadius="6" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="语音键触发方式" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <RadioButton Content="按住说话" GroupName="VoiceTrigger" IsChecked="{Binding IsHoldToTalk}" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,20,0"/>
                            <RadioButton Content="单击切换" GroupName="VoiceTrigger" IsChecked="{Binding IsClickToToggle}" Foreground="{StaticResource PrimaryTextBrush}"/>
                        </StackPanel>
                        <TextBlock Text="当前语音触发快捷键：" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{x:Static vm:OnboardingViewModel.VoiceShortcutOptions}"
                                  SelectedItem="{Binding SelectedShortcutOption, Mode=TwoWay}"
                                  DisplayMemberPath="Label"
                                  Width="320" HorizontalAlignment="Left" Margin="0,0,0,10"
                                  AutomationProperties.Name="语音触发快捷键预设"/>
                        <StackPanel Margin="0,0,0,10"
                                    Visibility="{Binding ShowShortcutEditor, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBox Text="{Binding ShortcutText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Width="210" Background="#1E1E1E" Foreground="#FFF" Padding="8,5"
                                         VerticalContentAlignment="Center"
                                         AutomationProperties.Name="自定义语音快捷键"/>
                                <ToggleButton x:Name="VoiceShortcutRecordButton" Margin="10,0,0,0" Padding="14,5"
                                              ToolTip="点击后直接按下快捷键，按 Esc 取消录制"
                                              InputMethod.IsInputMethodEnabled="False"
                                              Checked="OnVoiceShortcutRecordChecked"
                                              PreviewKeyDown="OnVoiceShortcutRecordKeyDown"
                                              PreviewKeyUp="OnVoiceShortcutRecordKeyUp"
                                              LostKeyboardFocus="OnVoiceShortcutRecordLostFocus">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Setter Property="Content" Value="🎙️ 录制快捷键"/>
                                            <Setter Property="Background" Value="#3E3E42"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                            <Setter Property="BorderBrush" Value="#555555"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter Property="Content" Value="请按下快捷键..."/>
                                                    <Setter Property="Background" Value="#007ACC"/>
                                                    <Setter Property="BorderBrush" Value="#0098FF"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                            </StackPanel>
                            <TextBlock Text="支持单个修饰键（如右 Alt / 右 Ctrl）或组合键（如 Ctrl+F5），按 Esc 取消录制。"
                                       FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock Text="语音输入工具设置" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding InputToolSetupInstructions}" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" FontSize="12"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Step 7: Live Transcription Verification -->
            <StackPanel x:Name="Step7Panel" Visibility="Collapsed">
                <TextBlock Text="真实输入法转写验收" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,10"/>
                <TextBlock Text="{Binding TranscriptionInstructions}" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                <TextBox Text="{Binding TranscriptionTestText, UpdateSourceTrigger=PropertyChanged}" IsKeyboardFocusWithinChanged="OnTranscriptionFocusChanged" Height="70" Background="#111" Foreground="#FFF" FontSize="14" Padding="10" TextWrapping="Wrap" Margin="0,0,0,14"/>
                <CheckBox Content="我已确认上述输入法转写结果正确" IsChecked="{Binding IsTranscriptionVerified}" Foreground="#FFF"/>
            </StackPanel>

            <!-- Step 8: Completion -->
            <StackPanel x:Name="Step8Panel" Visibility="Collapsed">
                <TextBlock Text="{Binding CompleteSummaryTitle}" FontSize="20" FontWeight="Bold" Foreground="#00CC66" Margin="0,0,0,10"/>
                <TextBlock Text="{Binding CompleteSummaryDescription}" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,20"/>
            </StackPanel>
        </Grid>

        <!-- Bottom Navigation & Validation Bar -->
        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <!-- Validation Error Alert -->
            <TextBlock Text="{Binding ValidationError}" Foreground="#FF4444" FontWeight="SemiBold" Margin="0,0,0,10"
                       Visibility="{Binding ValidationError, Converter={StaticResource StringToVisibilityConverter}}"/>
            <Border Padding="0,10,0,0" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="0,1,0,0">
                <DockPanel LastChildFill="False">
                    <Button Content="上一步" DockPanel.Dock="Left" Width="100" Command="{Binding PreviousStepCommand}" IsEnabled="{Binding CanGoPrevious}"/>
                    <Button Content="{Binding NextButtonText}" DockPanel.Dock="Right" Width="120" Background="#007ACC" Command="{Binding NextStepCommand}"/>
                </DockPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
