<Window x:Class="RemoteBuddy.App.Views.ShortcutPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="自定义快捷键"
        Width="860"
        MinWidth="760" MinHeight="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource PrimaryBackgroundBrush}">
    <DockPanel Margin="16">
        <!-- Header & Preview -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="自定义快捷键" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
            <TextBlock Text="点击下方修饰键和普通按键组合快捷键，或点击“录制快捷键”直接按下键盘按键（支持独立左/右修饰键）。"
                       FontSize="12.5" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,10" TextWrapping="Wrap"/>

            <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8">
                <DockPanel LastChildFill="True">
                    <ToggleButton x:Name="RecordButton" DockPanel.Dock="Right" Padding="12,6" Margin="10,0,0,0"
                                  InputMethod.IsInputMethodEnabled="False"
                                  Checked="OnRecordChecked"
                                  PreviewKeyDown="OnRecordKeyDown"
                                  PreviewKeyUp="OnRecordKeyUp"
                                  LostKeyboardFocus="OnRecordLostFocus">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Content" Value="录制快捷键"/>
                                <Setter Property="Background" Value="#3E3E42"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="BorderBrush" Value="#555555"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="Content" Value="请按下快捷键… (Esc 取消)"/>
                                        <Setter Property="Background" Value="#007ACC"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <TextBlock x:Name="PreviewText" Text="请选择按键组合" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- Footer Buttons -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock x:Name="ValidationHintText" Foreground="#FFB347" FontSize="12" Margin="0,0,0,8" Visibility="Collapsed"/>
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="清空" Padding="12,6" Click="OnClearClick"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="取消" Padding="14,7" Margin="0,0,8,0" IsCancel="True" Click="OnCancelClick"/>
                    <Button x:Name="ConfirmButton" Content="使用此快捷键" Padding="16,7" Background="#007ACC" BorderBrush="#0098FF"
                            IsDefault="True" Click="OnConfirmClick"/>
                </StackPanel>
            </DockPanel>
        </StackPanel>

        <!-- Virtual Keyboard Grid -->
        <Border Background="#23252A" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="10" Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="KeyboardRowsPanel" VerticalAlignment="Center"/>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
