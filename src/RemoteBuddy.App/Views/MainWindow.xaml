<Window x:Class="RemoteBuddy.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:RemoteBuddy.App.ViewModels"
        xmlns:pages="clr-namespace:RemoteBuddy.App.Views.Pages"
        mc:Ignorable="d"
        Title="{Binding CurrentTitle}" Height="720" Width="1020"
        Icon="/Resources/app.ico"
        MinHeight="620" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PrimaryBackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBackgroundBrush}" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <!-- App Logo & Title -->
                <StackPanel DockPanel.Dock="Top" Margin="22,26,22,22">
                    <TextBlock Text="Remote Buddy" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                    <TextBlock Text="遥控搭子 · Windows" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Audio Activity Bar at Bottom -->
                <Border DockPanel.Dock="Bottom" Margin="16,10,16,16" Padding="14,12" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0"
                                     Fill="{Binding IsConnected, Converter={StaticResource BoolToBrushConverter}}"/>
                            <TextBlock Text="{Binding ConnectedDeviceName}" FontSize="12" FontWeight="Medium" Foreground="{StaticResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                        </StackPanel>
                        <TextBlock Text="麦克风收音电平" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                        <ProgressBar Value="{Binding CurrentAudioLevel, Mode=OneWay}" Minimum="0" Maximum="1" Height="6" Background="#222" Foreground="#00CC66" BorderThickness="0"/>
                    </StackPanel>
                </Border>

                <!-- Navigation Buttons: 3 Groups -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,0">
                        <!-- Group 1: General, Permission, Remote, Integration -->
                        <Button Content="⚙️  通用" HorizontalContentAlignment="Left" Margin="0,2" Padding="14,9"
                                Background="{Binding ActivePageName, Converter={StaticResource EqualValueToBrushConverter}, ConverterParameter=General}"
                                Command="{Binding NavigateCommand}" CommandParameter="General"/>
                        <Button Content="🛡️  权限与驱动" HorizontalContentAlignment="Left" Margin="0,2" Padding="14,9"
                                Background="{Binding ActivePageName, Converter={StaticResource EqualValueToBrushConverter}, ConverterParameter=Permissions}"
                                Command="{Binding NavigateCommand}" CommandParameter="Permissions"/>
                        <Button Content="📱  遥控器连接" HorizontalContentAlignment="Left" Margin="0,2" Padding="14,9"
                                Background="{Binding ActivePageName, Converter={StaticResource EqualValueToBrushConverter}, ConverterParameter=Devices}"
                                Command="{Binding NavigateCommand}" CommandParameter="Devices"/>
                        <Button Content="🎙️  输入法集成" HorizontalContentAlignment="Left" Margin="0,2" Padding="14,9"
                                Background="{Binding ActivePageName, Converter={StaticResource EqualValueToBrushConverter}, ConverterParameter=Integrations}"
                                Command="{Binding NavigateCommand}" CommandParameter="Integrations"/>

                        <!-- Divider 1 -->
                        <Border Height="1" Background="{StaticResource BorderColorBrush}" Margin="4,8"/>

                        <!-- Group 2: Key Mappings, App Integration -->
                        <Button Content="⌨️  按键映射" HorizontalContentAlignment="Left" Margin="0,2" Padding="14,9"
                                Background="{Binding ActivePageName, Converter={StaticResource EqualValueToBrushConverter}, ConverterParameter=Mapping}"
                                Command="{Binding NavigateCommand}" CommandParameter="Mapping"/>
                        <Button Content="🎯  应用集成" HorizontalContentAlignment="Left" Margin="0,2" Padding="14,9"
                                Background="{Binding ActivePageName, Converter={StaticResource EqualValueToBrushConverter}, ConverterParameter=AppIntegration}"
                                Command="{Binding NavigateCommand}" CommandParameter="AppIntegration"/>

                        <!-- Divider 2 -->
                        <Border Height="1" Background="{StaticResource BorderColorBrush}" Margin="4,8"/>

                        <!-- Group 3: About -->
                        <Button Content="ℹ️  关于" HorizontalContentAlignment="Left" Margin="0,2" Padding="14,9"
                                Background="{Binding ActivePageName, Converter={StaticResource EqualValueToBrushConverter}, ConverterParameter=About}"
                                Command="{Binding NavigateCommand}" CommandParameter="About"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1" Margin="26">
            <!-- Dynamic Page Swap Handled in Code-Behind -->
            <ContentControl x:Name="PageContentContainer"/>
        </Grid>
    </Grid>
</Window>
