<UserControl x:Class="RemoteBuddy.App.Views.Pages.AppIntegrationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,24">
            <!-- Header -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="应用集成" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                    <TextBlock Text="在特定应用中按语音键时，优先对准当前对话输入框"
                               Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <Button x:Name="HeaderFaqLinkButton"
                        Grid.Column="1"
                        Style="{StaticResource HeaderLinkButtonStyle}"
                        Content="应用集成与核心作用 (FAQ) ↗"
                        VerticalAlignment="Top"
                        Margin="0,4,0,0"
                        Command="{Binding OpenFaqCommand}"
                        ToolTip="https://remote.zfdang.com/faq.html#integrations"
                        AutomationProperties.Name="应用集成与核心作用 (FAQ)"/>
            </Grid>

            <!-- Introduction Card -->
            <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="打开目标应用和会话，按下遥控器语音键。搭子会保留当前输入框的焦点，或尝试定位当前对话的输入框。"
                               FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Text="只有前台应用的集成已开启时才会尝试聚焦。找不到明确的输入框时，语音输入会继续使用当前焦点。"
                               FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Supported Apps Toolbar -->
            <DockPanel LastChildFill="False" Margin="0,0,0,12">
                <TextBlock Text="支持的应用" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="全部开启" Margin="0,0,8,0" Padding="12,5" FontSize="12"
                            Command="{Binding EnableAllCommand}"/>
                    <Button Content="全部关闭" Padding="12,5" FontSize="12"
                            Command="{Binding DisableAllCommand}"/>
                </StackPanel>
            </DockPanel>

            <!-- Applications List -->
            <ItemsControl ItemsSource="{Binding Applications}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="8" Padding="18,14" Margin="0,0,0,10">
                            <DockPanel LastChildFill="True">
                                <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
