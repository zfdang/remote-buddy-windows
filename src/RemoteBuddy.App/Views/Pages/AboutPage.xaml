<UserControl x:Class="RemoteBuddy.App.Views.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,24">
            <!-- Header -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="关于" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                <TextBlock Text="关于 Remote Buddy、版本信息与本地诊断" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Hero Card -->
            <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,18">
                <DockPanel LastChildFill="True">
                    <Image Source="/Resources/app.png" Width="52" Height="52" Margin="0,0,18,0" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Remote Buddy (Windows)" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="遥控搭子 · 让闲置的蓝牙电视遥控器化身桌面语音输入神器" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Card 1: Version and Platform Info -->
            <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="版本信息" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,14"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="客户端版本" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,3"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AppVersion}" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,3"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="平台架构" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,3"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Architecture}" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,3"/>
                    </Grid>

                    <DockPanel Margin="0,14,0,0">
                        <Button DockPanel.Dock="Right" Content="立即检查更新" Command="{Binding CheckForUpdatesCommand}"
                                Margin="12,0,0,0" Padding="12,6"/>
                        <CheckBox Content="接收更新提醒" IsChecked="{Binding ReceiveUpdateNotifications, Mode=TwoWay}"
                                  VerticalAlignment="Center" Foreground="{StaticResource PrimaryTextBrush}"/>
                    </DockPanel>

                    <TextBlock Text="{Binding UpdateStatus}" Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap" Margin="0,10,0,0"
                               Visibility="{Binding UpdateStatus, Converter={StaticResource StringToVisibilityConverter}}"/>

                    <Border Margin="0,12,0,0" Padding="12" CornerRadius="6" BorderThickness="1"
                            BorderBrush="{StaticResource BorderColorBrush}"
                            Visibility="{Binding HasAvailableRelease, Converter={StaticResource BoolToVisibilityConverter}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="前往下载" Command="{Binding OpenUpdateDownloadCommand}"
                                    Margin="12,0,0,0" Padding="12,6" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="{Binding AvailableVersionText}"
                                           Foreground="{StaticResource PrimaryTextBrush}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding AvailablePackageText}"
                                           Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Card 2: Diagnostic Logs -->
            <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,18">
                <StackPanel>
                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" MaxWidth="480">
                            <TextBlock Text="诊断日志与故障排查" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                            <TextBlock Text="仅在需要排查问题时开启；关闭后将不再生成或写入本地日志文件。可一键复制脱敏诊断摘要（最多附带最近 300 行日志）用于反馈，严禁且不记录任何语音音频或转写文本。"
                                       FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,4,0,10"/>
                            <CheckBox Content="启用排错日志" IsChecked="{Binding DiagnosticLoggingEnabled, Mode=TwoWay}" Foreground="#FFF" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding LogDirectoryPath, StringFormat='存储路径: {0}'}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Width="168">
                            <Button Content="📁 打开日志文件夹" Padding="14,8" Margin="0,0,0,8"
                                    Command="{Binding OpenLogFolderCommand}"/>
                            <Button Content="📋 复制诊断信息" Padding="14,8" Background="#007ACC"
                                    Command="{Binding CopyDiagnosticSummaryCommand}"/>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="{Binding DiagnosticCopyStatus}" Foreground="{Binding DiagnosticCopyStatusColor}"
                               FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"
                               Visibility="{Binding HasDiagnosticCopyStatus, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
            </Border>

            <!-- Card 3: Open Source & Links -->
            <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,18">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="开源许可与项目链接" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                        <TextBlock Text="本项目遵循 GPL-3.0-only 开源协议发布。" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <Button Content="🌐 访问产品官网" Margin="0,0,10,0" Padding="12,7"
                                Command="{Binding OpenWebsiteCommand}"/>
                        <Button Content="📦 GitHub 仓库" Padding="12,7"
                                Command="{Binding OpenGitHubCommand}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
