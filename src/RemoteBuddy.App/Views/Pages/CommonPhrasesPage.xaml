<UserControl x:Class="RemoteBuddy.App.Views.Pages.CommonPhrasesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <!-- Top Header -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="导入备份会替换当前常用语和按键分配。" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button Content="导入备份" Padding="11,6" Margin="0,0,8,0" Click="OnImportClick"/>
                <Button Content="导出备份" Padding="11,6" Click="OnExportClick"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="← 返回" Padding="12,7" Margin="0,0,14,0" Command="{Binding ReturnCommand}"/>
                <TextBlock Text="调整常用语" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
            </StackPanel>
        </DockPanel>

        <!-- 3-Column Workspace -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="270"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Column 1: Button Assignment -->
            <Border Grid.Column="0" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="按键分配" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="先点击按键位置，再选择常用语。" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,12" TextWrapping="Wrap"/>

                        <!-- Circular D-Pad -->
                        <Border Width="228" Height="228" CornerRadius="114" Background="#17191D" BorderBrush="#3B3F47" BorderThickness="1.5" HorizontalAlignment="Center" Margin="0,0,0,12"
                                Visibility="{Binding ShowBasePadButtons, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid>
                                <!-- Up -->
                                <Button HorizontalAlignment="Center" VerticalAlignment="Top" Width="96" Height="56" Margin="0,10,0,0"
                                        Click="OnPadButtonClick" Tag="{Binding PadUp.Button}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PadUp.IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="#1B3C5E"/>
                                                    <Setter Property="BorderBrush" Value="#3399FF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="▲" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding PadUp.AssignedLabel}" FontSize="12" Foreground="{StaticResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="84"/>
                                    </StackPanel>
                                </Button>

                                <!-- Down -->
                                <Button HorizontalAlignment="Center" VerticalAlignment="Bottom" Width="96" Height="56" Margin="0,0,0,10"
                                        Click="OnPadButtonClick" Tag="{Binding PadDown.Button}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PadDown.IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="#1B3C5E"/>
                                                    <Setter Property="BorderBrush" Value="#3399FF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding PadDown.AssignedLabel}" FontSize="12" Foreground="{StaticResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="84"/>
                                        <TextBlock Text="▼" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- Left -->
                                <Button HorizontalAlignment="Left" VerticalAlignment="Center" Width="62" Height="78" Margin="8,0,0,0"
                                        Click="OnPadButtonClick" Tag="{Binding PadLeft.Button}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PadLeft.IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="#1B3C5E"/>
                                                    <Setter Property="BorderBrush" Value="#3399FF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="◀" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding PadLeft.AssignedLabel}" FontSize="11.5" Foreground="{StaticResource PrimaryTextBrush}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="54"/>
                                    </StackPanel>
                                </Button>

                                <!-- Right -->
                                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Width="62" Height="78" Margin="0,0,8,0"
                                        Click="OnPadButtonClick" Tag="{Binding PadRight.Button}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PadRight.IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="#1B3C5E"/>
                                                    <Setter Property="BorderBrush" Value="#3399FF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="▶" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding PadRight.AssignedLabel}" FontSize="11.5" Foreground="{StaticResource PrimaryTextBrush}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="54"/>
                                    </StackPanel>
                                </Button>

                                <!-- Center OK -->
                                <Button HorizontalAlignment="Center" VerticalAlignment="Center" Width="82" Height="82"
                                        Click="OnPadButtonClick" Tag="{Binding PadOk.Button}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="OkCircle" CornerRadius="41" Background="#24272D" BorderBrush="#494E59" BorderThickness="1.5">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding PadOk.IsSelected}" Value="True">
                                                    <Setter TargetName="OkCircle" Property="Background" Value="#1B3C5E"/>
                                                    <Setter TargetName="OkCircle" Property="BorderBrush" Value="#3399FF"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="OK" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding PadOk.AssignedLabel}" FontSize="11.5" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="68" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <TextBlock Text="当前遥控器的方向键与 OK 键在 Windows 上保留原生键盘输入，常用语仅使用下方非原生键盘按键。"
                                   FontSize="12" Foreground="#A9D7FF" TextWrapping="Wrap" Margin="0,0,0,10"
                                   Visibility="{Binding ShowBasePadButtons, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}"/>

                        <!-- Model Extra Buttons -->
                        <ItemsControl ItemsSource="{Binding ExtraButtons}" Margin="0,0,0,10">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="3" Padding="8,7" Click="OnPadButtonClick" Tag="{Binding Button}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Background" Value="#23252A"/>
                                                <Setter Property="BorderBrush" Value="#3B3F47"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="#1B3C5E"/>
                                                        <Setter Property="BorderBrush" Value="#3399FF"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding ShortTitle}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding AssignedLabel}" FontSize="11.5" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="105" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{Binding AssignInstructionText}" FontSize="12" Foreground="#7BC3FF" TextWrapping="Wrap" Margin="0,0,0,4"/>
                        <TextBlock Text="这里只调整分配，不插入文字。" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Column 2: Phrase Library -->
            <Border Grid.Column="2" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="常用语库" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right" Content="＋ 新增" Padding="10,5" Command="{Binding NewPhraseCommand}"/>
                    </DockPanel>

                    <TextBox DockPanel.Dock="Top" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,6" Margin="0,0,0,10" ToolTip="搜索常用语"/>

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0"
                                Visibility="{Binding CanMoveSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Button Content="↑ 上移" Padding="10,5" Margin="0,0,8,0" Command="{Binding MoveUpCommand}"/>
                        <Button Content="↓ 下移" Padding="10,5" Command="{Binding MoveDownCommand}"/>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding FilteredPhrases}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,0,0,4" Padding="9,7" HorizontalContentAlignment="Stretch"
                                            Click="OnPhraseRowClick" Tag="{Binding Id}" ToolTip="{Binding Text}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Background" Value="#24262B"/>
                                                <Setter Property="BorderBrush" Value="#383B42"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="#1B3C5E"/>
                                                        <Setter Property="BorderBrush" Value="#3399FF"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <DockPanel LastChildFill="True">
                                            <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding AssignedBadges}" VerticalAlignment="Center">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#1B1D22" BorderBrush="#494E59" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="3,0,0,0">
                                                            <TextBlock Text="{Binding ShortText}" FontSize="11" Foreground="#A9D7FF"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding Label}" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Column 3: Phrase Editor -->
            <Border Grid.Column="4" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="编辑内容" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,14"/>

                        <TextBlock Text="简短标签" FontSize="12.5" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding EditLabel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="9,7" Margin="0,0,0,14"/>

                        <TextBlock Text="完整内容" FontSize="12.5" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding EditText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" Padding="9,7" Margin="0,0,0,6"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock Text="{Binding CharacterCountText}" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOverCharacterLimit}" Value="True">
                                                <Setter Property="Foreground" Value="#FF6666"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding WhitespaceHint}" FontSize="12" Foreground="#FFB347" Margin="10,0,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding HasWhitespaceHint, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Button Content="保存更改" Padding="16,8" Background="#007ACC" BorderBrush="#0098FF" Margin="0,0,10,0"
                                    IsEnabled="{Binding CanSave}" Command="{Binding SavePhraseCommand}"/>
                            <Button Content="🗑 删除这条" Padding="12,8"
                                    Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Command="{Binding DeletePhraseCommand}"/>
                        </StackPanel>

                        <TextBlock Text="保存在本地配置目录，重启后仍保留。切换界面语言不会改变常用语内容。"
                                   FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <TextBlock Text="{Binding StatusMessage}" FontSize="12.5" TextWrapping="Wrap"
                                   Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#83D8C4"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                            <Setter Property="Foreground" Value="#FF6666"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
