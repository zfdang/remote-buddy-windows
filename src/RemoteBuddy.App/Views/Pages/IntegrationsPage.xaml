<UserControl x:Class="RemoteBuddy.App.Views.Pages.IntegrationsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:RemoteBuddy.App.Converters"
             xmlns:vm="clr-namespace:RemoteBuddy.App.ViewModels">
    <UserControl.Resources>
        <converters:EqualValueToBrushConverter x:Key="ActiveToolBorderConverter">
            <converters:EqualValueToBrushConverter.ActiveBrush>
                <SolidColorBrush Color="#00CC66"/>
            </converters:EqualValueToBrushConverter.ActiveBrush>
            <converters:EqualValueToBrushConverter.InactiveBrush>
                <SolidColorBrush Color="#3E3E42"/>
            </converters:EqualValueToBrushConverter.InactiveBrush>
        </converters:EqualValueToBrushConverter>

        <converters:EqualValueToBrushConverter x:Key="ActiveToolBackgroundConverter">
            <converters:EqualValueToBrushConverter.ActiveBrush>
                <SolidColorBrush Color="#15281C"/>
            </converters:EqualValueToBrushConverter.ActiveBrush>
            <converters:EqualValueToBrushConverter.InactiveBrush>
                <SolidColorBrush Color="#2D2D30"/>
            </converters:EqualValueToBrushConverter.InactiveBrush>
        </converters:EqualValueToBrushConverter>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,24">
            <!-- Page Header -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="输入法与语音工具集成" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                    <TextBlock Text="查看当前生效的语音触发方式与输入工具；如需更换或测试，请通过向导完成。"
                               Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <Button x:Name="HeaderFaqLinkButton"
                        Grid.Column="1"
                        Style="{StaticResource HeaderLinkButtonStyle}"
                        Content="输入法生态与模式转换 (FAQ) ↗"
                        VerticalAlignment="Top"
                        Margin="0,4,0,0"
                        Command="{Binding OpenFaqCommand}"
                        ToolTip="https://remote.zfdang.com/faq.html#input-methods"
                        AutomationProperties.Name="输入法生态与模式转换 (FAQ)"/>
            </Grid>

            <!-- Top Status Panels -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Panel 1: 语音触发方式 -->
                <Border Grid.Column="0" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
                    <StackPanel>
                        <TextBlock Text="语音触发方式" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="⌨️ 语音键：" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13"/>
                            <TextBlock Text="{Binding CurrentTriggerModeDisplay}" Foreground="#FFFFFF" FontWeight="Medium" FontSize="13"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="🔘 唤起按键：" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13"/>
                            <Border Background="#25272B" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="{Binding CurrentShortcutDisplay}" Foreground="#FFF" FontFamily="Consolas" FontSize="12"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔊 音频路由：" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13"/>
                            <TextBlock Text="{Binding VirtualCableStatusDescription}" Foreground="{Binding VirtualCableStatusBrush}" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Panel 2: 当前集成工具 -->
                <Border Grid.Column="2" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
                    <StackPanel>
                        <TextBlock Text="当前集成工具" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,12"/>
                        <TextBlock Text="{Binding CurrentToolDisplayName}" FontSize="20" FontWeight="SemiBold" Foreground="#4DA6FF" Margin="0,0,0,10"/>
                        <Border Background="#25282E" CornerRadius="6" Padding="10,8">
                            <TextBlock Text="💡 提示：输入法中的录音麦克风需指定为【CABLE Output (VB-Audio Virtual Cable)】"
                                       FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Prominent Wizard Action Divider -->
            <Grid Margin="0,6,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Rectangle Grid.Column="0" Height="1" Fill="#3E3E42" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Margin="20,0" Padding="24,10" Background="#007ACC"
                        Command="{Binding RunWizardCommand}"
                        FontWeight="SemiBold" FontSize="14"
                        Content="通过向导修改语音键与输入工具"/>
                <Rectangle Grid.Column="2" Height="1" Fill="#3E3E42" VerticalAlignment="Center"/>
            </Grid>

            <!-- Presets Section Header -->
            <TextBlock Text="支持的语音工具" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,12"/>

            <!-- Presets Grid -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Tool 1: WeChat Input -->
                <Border Grid.Row="0" Grid.Column="0"
                        Background="{Binding SelectedTool, Converter={StaticResource ActiveToolBackgroundConverter}, ConverterParameter=WeChatInput}"
                        BorderBrush="{Binding SelectedTool, Converter={StaticResource ActiveToolBorderConverter}, ConverterParameter=WeChatInput}"
                        BorderThickness="1.5" CornerRadius="12" Padding="18">
                    <DockPanel LastChildFill="True">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock Text="微信输入法" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                            <Border Background="#1C3827" BorderBrush="#2D6A42" BorderThickness="1" CornerRadius="10" Padding="8,2" HorizontalAlignment="Right"
                                    Visibility="{Binding SelectedTool, Converter={StaticResource EqualValueToVisibilityConverter}, ConverterParameter=WeChatInput}">
                                <TextBlock Text="当前使用" FontSize="11" Foreground="#44FF88" FontWeight="SemiBold"/>
                            </Border>
                        </DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
                            <TextBlock Text="✓ 正在生效" Foreground="#00CC66" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"
                                       Visibility="{Binding SelectedTool, Converter={StaticResource EqualValueToVisibilityConverter}, ConverterParameter=WeChatInput}"/>
                        </StackPanel>
                        <TextBlock Text="{x:Static vm:OnboardingViewModel.WeChatVoiceSetup}"
                                   FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                    </DockPanel>
                </Border>

                <!-- Tool 2: Doubao -->
                <Border Grid.Row="0" Grid.Column="2"
                        Background="{Binding SelectedTool, Converter={StaticResource ActiveToolBackgroundConverter}, ConverterParameter=DoubaoInput}"
                        BorderBrush="{Binding SelectedTool, Converter={StaticResource ActiveToolBorderConverter}, ConverterParameter=DoubaoInput}"
                        BorderThickness="1.5" CornerRadius="12" Padding="18">
                    <DockPanel LastChildFill="True">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock Text="豆包输入法 / 客户端" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                            <Border Background="#1C3827" BorderBrush="#2D6A42" BorderThickness="1" CornerRadius="10" Padding="8,2" HorizontalAlignment="Right"
                                    Visibility="{Binding SelectedTool, Converter={StaticResource EqualValueToVisibilityConverter}, ConverterParameter=DoubaoInput}">
                                <TextBlock Text="当前使用" FontSize="11" Foreground="#44FF88" FontWeight="SemiBold"/>
                            </Border>
                        </DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
                            <TextBlock Text="✓ 正在生效" Foreground="#00CC66" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"
                                       Visibility="{Binding SelectedTool, Converter={StaticResource EqualValueToVisibilityConverter}, ConverterParameter=DoubaoInput}"/>
                        </StackPanel>
                        <TextBlock Text="{x:Static vm:OnboardingViewModel.DoubaoVoiceSetup}"
                                   FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                    </DockPanel>
                </Border>

                <!-- Tool 3: Windows Dictation -->
                <Border Grid.Row="2" Grid.Column="0"
                        Background="{Binding SelectedTool, Converter={StaticResource ActiveToolBackgroundConverter}, ConverterParameter=WindowsDictation}"
                        BorderBrush="{Binding SelectedTool, Converter={StaticResource ActiveToolBorderConverter}, ConverterParameter=WindowsDictation}"
                        BorderThickness="1.5" CornerRadius="12" Padding="18">
                    <DockPanel LastChildFill="True">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock Text="Windows 语音听写" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                            <Border Background="#1C3827" BorderBrush="#2D6A42" BorderThickness="1" CornerRadius="10" Padding="8,2" HorizontalAlignment="Right"
                                    Visibility="{Binding SelectedTool, Converter={StaticResource EqualValueToVisibilityConverter}, ConverterParameter=WindowsDictation}">
                                <TextBlock Text="当前使用" FontSize="11" Foreground="#44FF88" FontWeight="SemiBold"/>
                            </Border>
                        </DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
                            <TextBlock Text="✓ 正在生效" Foreground="#00CC66" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"
                                       Visibility="{Binding SelectedTool, Converter={StaticResource EqualValueToVisibilityConverter}, ConverterParameter=WindowsDictation}"/>
                        </StackPanel>
                        <TextBlock Text="Windows 10/11 内置原生语音听写，单击切换开始与停止，无需安装第三方软件。（快捷键 Win+H）"
                                   FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                    </DockPanel>
                </Border>

                <!-- Tool 4: Typeless -->
                <Border Grid.Row="2" Grid.Column="2"
                        Background="{Binding SelectedTool, Converter={StaticResource ActiveToolBackgroundConverter}, ConverterParameter=Typeless}"
                        BorderBrush="{Binding SelectedTool, Converter={StaticResource ActiveToolBorderConverter}, ConverterParameter=Typeless}"
                        BorderThickness="1.5" CornerRadius="12" Padding="18">
                    <DockPanel LastChildFill="True">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock Text="Typeless 智能转写" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                            <Border Background="#1C3827" BorderBrush="#2D6A42" BorderThickness="1" CornerRadius="10" Padding="8,2" HorizontalAlignment="Right"
                                    Visibility="{Binding SelectedTool, Converter={StaticResource EqualValueToVisibilityConverter}, ConverterParameter=Typeless}">
                                <TextBlock Text="当前使用" FontSize="11" Foreground="#44FF88" FontWeight="SemiBold"/>
                            </Border>
                        </DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
                            <TextBlock Text="✓ 正在生效" Foreground="#00CC66" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"
                                       Visibility="{Binding SelectedTool, Converter={StaticResource EqualValueToVisibilityConverter}, ConverterParameter=Typeless}"/>
                        </StackPanel>
                        <TextBlock Text="支持 Typeless 全局听写客户端，长按语音键录音，松开即刻转写为精准文字。（默认快捷键 Ctrl+Alt+V）"
                                   FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                    </DockPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
