<UserControl x:Class="RemoteBuddy.App.Views.Pages.MappingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:model="clr-namespace:RemoteBuddy.Core.Models;assembly=RemoteBuddy.Core"
             xmlns:vm="clr-namespace:RemoteBuddy.App.ViewModels">
    <UserControl.Resources>
        <Storyboard x:Key="RemoteButtonPress" FillBehavior="Stop">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.88"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.12" Value="0.88"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.26" Value="1"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.88"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.12" Value="0.88"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.26" Value="1"/>
            </DoubleAnimationUsingKeyFrames>
            <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(Control.BorderBrush).(SolidColorBrush.Color)">
                <DiscreteColorKeyFrame KeyTime="0:0:0" Value="#4DA6FF"/>
                <DiscreteColorKeyFrame KeyTime="0:0:0.26" Value="#4DA6FF"/>
            </ColorAnimationUsingKeyFrames>
        </Storyboard>

        <DataTemplate x:Key="GestureEditor">
            <StackPanel Margin="0,14,0,0">
                <TextBlock Text="{Binding Help}" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <ComboBox ItemsSource="{Binding AvailableActions}" SelectedItem="{Binding Action, Mode=TwoWay}"
                          AutomationProperties.Name="动作类型" Margin="0,0,0,12">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource EnumToDisplayNameConverter}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <StackPanel Visibility="{Binding Action, Converter={StaticResource EqualValueToVisibilityConverter}, ConverterParameter=KeyboardShortcut}">
                    <TextBlock Text="键盘快捷键" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                    <DockPanel Margin="0,0,0,8">
                        <ToggleButton DockPanel.Dock="Right" Margin="8,0,0,0" Padding="8,5" ToolTip="按 Esc 取消录制"
                                      InputMethod.IsInputMethodEnabled="False"
                                      PreviewKeyDown="RecordShortcut" LostKeyboardFocus="StopRecordingShortcut">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Content" Value="录制"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="Content" Value="请按快捷键"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                        <TextBox Text="{Binding Shortcut, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 AutomationProperties.Name="键盘快捷键" Padding="8,5"/>
                    </DockPanel>
                    <TextBlock Text="常用快捷键" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{x:Static vm:MappingGestureViewModel.ShortcutPresets}" DisplayMemberPath="Key"
                              SelectionChanged="ApplyShortcutPreset" AutomationProperties.Name="常用快捷键"/>
                </StackPanel>
                <StackPanel Visibility="{Binding Action, Converter={StaticResource EqualValueToVisibilityConverter}, ConverterParameter=MediaControl}">
                    <TextBlock Text="媒体操作" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{x:Static vm:MappingGestureViewModel.AvailableMediaCommands}"
                              SelectedItem="{Binding Media, Mode=TwoWay}" AutomationProperties.Name="媒体操作">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumToDisplayNameConverter}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <StackPanel Visibility="{Binding Action, Converter={StaticResource EqualValueToVisibilityConverter}, ConverterParameter=TextSnippet}">
                    <TextBlock Text="常用短语" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             AutomationProperties.Name="常用短语" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="65" Padding="8,5"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <DockPanel>
        <!-- Page Header -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="按键映射" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                <TextBlock Text="{Binding DeviceNote}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="遥控器" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" DisplayMemberPath="Name" Width="170" Margin="0,0,14,0"/>
                <CheckBox Content="启用自定义按键" IsChecked="{Binding CustomMappingEnabled}" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Bottom Footer: RawInput Status & Selection Lock & Reset Defaults -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,16,0,0">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="⌨️ " FontSize="13"/>
                    <TextBlock Text="按实体遥控器查看按键反馈" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" Margin="0,0,18,0"/>
                    <CheckBox Content="锁定当前按键 (按实体遥控器时不自动切换选择)" IsChecked="{Binding IsMappingSelectionLocked}" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="🔄 恢复默认映射" DockPanel.Dock="Right" Padding="12,6" Background="Transparent" BorderBrush="{StaticResource BorderColorBrush}" Foreground="{StaticResource SecondaryTextBrush}"
                        Command="{Binding ResetToDefaultsCommand}"/>
            </DockPanel>
        </Border>

        <!-- Main 2-Column Mapping Workspace -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column: Visual Remote & Button Selector -->
            <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="实体遥控器按键" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,12"/>

                    <!-- Visual Remote Control Body -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="RemoteButtons" HorizontalAlignment="Center">
                            <StackPanel.Resources>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform/>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </StackPanel.Resources>
                            <!-- 1. Xiaomi Remote Control Body -->
                            <Border Background="#242629" BorderBrush="#3E4249" BorderThickness="1" CornerRadius="28" Padding="14,10" Width="210"
                                    Visibility="{Binding IsXiaomi, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <!-- Top Row: Power & Voice -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="⏻ 电源" Tag="Power" Click="SelectRemoteButton"
                                                Height="36" Margin="4,0" Background="#332B2B" Foreground="#FF8888" BorderBrush="#553333"/>
                                        <Button Grid.Column="1" Content="🎙️ 语音" Tag="Voice" Click="SelectRemoteButton"
                                                Height="36" Margin="4,0" Background="#223344" Foreground="#88CCFF" BorderBrush="#335577"
                                                ToolTip="语音键由【输入法集成】配置全局生效"/>
                                    </Grid>

                                    <!-- Directional Ring (D-Pad) -->
                                    <Border Background="#1C1D20" BorderBrush="#383B42" BorderThickness="1" CornerRadius="64" Width="128" Height="128" Margin="0,0,0,8">
                                        <Grid>
                                            <Button Content="▲" Tag="Up" Click="SelectRemoteButton"
                                                    HorizontalAlignment="Center" VerticalAlignment="Top" Width="38" Height="30" Margin="0,5,0,0"/>
                                            <Button Content="▼" Tag="Down" Click="SelectRemoteButton"
                                                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Width="38" Height="30" Margin="0,0,0,5"/>
                                            <Button Content="◀" Tag="Left" Click="SelectRemoteButton"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center" Width="30" Height="38" Margin="5,0,0,0"/>
                                            <Button Content="▶" Tag="Right" Click="SelectRemoteButton"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center" Width="30" Height="38" Margin="0,0,5,0"/>
                                            <Button Content="OK" Tag="Ok" Click="SelectRemoteButton"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center" Width="46" Height="46"
                                                    FontWeight="Bold" Background="#383A40"/>
                                        </Grid>
                                    </Border>

                                    <!-- Navigation Keys Grid -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="34"/>
                                            <RowDefinition Height="34"/>
                                            <RowDefinition Height="34"/>
                                        </Grid.RowDefinitions>
                                        <Button Grid.Row="0" Grid.Column="0" Content="↩ 返回" Tag="Back" Click="SelectRemoteButton" Margin="3"/>
                                        <Button Grid.Row="0" Grid.Column="1" Content="🔊 音量 +" Tag="VolumeUp" Click="SelectRemoteButton" Margin="3"/>
                                        <Button Grid.Row="1" Grid.Column="0" Content="⌂ 主页" Tag="Home" Click="SelectRemoteButton" Margin="3"/>
                                        <Button Grid.Row="1" Grid.Column="1" Content="🔉 音量 −" Tag="VolumeDown" Click="SelectRemoteButton" Margin="3"/>
                                        <Button Grid.Row="2" Grid.Column="0" Content="≡ 菜单" Tag="Menu" Click="SelectRemoteButton" Margin="3"/>
                                        <Button Grid.Row="2" Grid.Column="1" Content="📺 电视 / TV" Tag="LiveTv" Click="SelectRemoteButton" Margin="3"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <!-- 2. Google Chromecast G9N9N Remote Body -->
                            <Border Background="#242629" BorderBrush="#3E4249" BorderThickness="1" CornerRadius="28" Padding="14,10" Width="210"
                                    Visibility="{Binding IsG9N9N, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <!-- Directional Ring (D-Pad) -->
                                    <Border Background="#1C1D20" BorderBrush="#383B42" BorderThickness="1" CornerRadius="64" Width="128" Height="128" Margin="0,0,0,8">
                                        <Grid>
                                            <Button Content="▲" Tag="Up" Click="SelectRemoteButton"
                                                    HorizontalAlignment="Center" VerticalAlignment="Top" Width="38" Height="30" Margin="0,5,0,0"/>
                                            <Button Content="▼" Tag="Down" Click="SelectRemoteButton"
                                                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Width="38" Height="30" Margin="0,0,0,5"/>
                                            <Button Content="◀" Tag="Left" Click="SelectRemoteButton"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center" Width="30" Height="38" Margin="5,0,0,0"/>
                                            <Button Content="▶" Tag="Right" Click="SelectRemoteButton"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center" Width="30" Height="38" Margin="0,0,5,0"/>
                                            <Button Content="OK" Tag="Ok" Click="SelectRemoteButton"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center" Width="46" Height="46"
                                                    FontWeight="Bold" Background="#383A40"/>
                                        </Grid>
                                    </Border>

                                    <!-- Middle Controls: Back & Voice -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="↩ 返回" Tag="Back" Click="SelectRemoteButton" Height="32" Margin="3"/>
                                        <Button Grid.Column="1" Content="🎙️ 语音" Tag="Voice" Click="SelectRemoteButton" Height="32" Margin="3"
                                                Background="#223344" Foreground="#88CCFF" BorderBrush="#335577"
                                                ToolTip="短按免提、长按松手即停"/>
                                    </Grid>

                                    <!-- Home & Mute -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="⌂ 主页" Tag="Home" Click="SelectRemoteButton" Height="32" Margin="3"/>
                                        <Button Grid.Column="1" Content="🔇 静音" Tag="Mute" Click="SelectRemoteButton" Height="32" Margin="3"/>
                                    </Grid>

                                    <!-- YouTube & Netflix App Keys -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="▶ YouTube" Tag="YouTube" Click="SelectRemoteButton" Height="32" Margin="3"
                                                Foreground="#FF6666"/>
                                        <Button Grid.Column="1" Content="N Netflix" Tag="Netflix" Click="SelectRemoteButton" Height="32" Margin="3"
                                                Foreground="#FF4444"/>
                                    </Grid>

                                    <!-- Bottom: Power & Input -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="⏻ 电源" Tag="Power" Click="SelectRemoteButton" Height="32" Margin="3"
                                                Background="#332B2B" Foreground="#FF8888" BorderBrush="#553333"/>
                                        <Button Grid.Column="1" Content="📺 输入源" Tag="Input" Click="SelectRemoteButton" Height="32" Margin="3"/>
                                    </Grid>

                                    <!-- Side Volume Buttons -->
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="🔊 音量 +" Tag="VolumeUp" Click="SelectRemoteButton" Height="30" Margin="3"/>
                                        <Button Grid.Column="1" Content="🔉 音量 −" Tag="VolumeDown" Click="SelectRemoteButton" Height="30" Margin="3"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 3. T1 Remote Control Body -->
                            <Border Background="#242629" BorderBrush="#3E4249" BorderThickness="1" CornerRadius="28" Padding="14,10" Width="210"
                                    Visibility="{Binding IsT1, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <!-- Top Row: Power & Voice -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="⏻ 电源" Tag="Power" Click="SelectRemoteButton"
                                                Height="36" Margin="4,0" Background="#332B2B" Foreground="#FF8888" BorderBrush="#553333"/>
                                        <Button Grid.Column="1" Content="🎙️ 语音" Tag="Voice" Click="SelectRemoteButton"
                                                Height="36" Margin="4,0" Background="#223344" Foreground="#88CCFF" BorderBrush="#335577"
                                                ToolTip="T1 语音键按一下开启、再按一下结束"/>
                                    </Grid>

                                    <!-- Front Row 1: Back & Home -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="↩ 返回" Tag="Back" Click="SelectRemoteButton" Height="34" Margin="3"/>
                                        <Button Grid.Column="1" Content="⌂ 主页" Tag="Home" Click="SelectRemoteButton" Height="34" Margin="3"/>
                                    </Grid>

                                    <!-- Front Row 2: Menu & Mute -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="≡ 菜单" Tag="Menu" Click="SelectRemoteButton" Height="34" Margin="3"/>
                                        <Button Grid.Column="1" Content="🔇 静音" Tag="Mute" Click="SelectRemoteButton" Height="34" Margin="3"/>
                                    </Grid>

                                    <!-- Front Row 3: VolumeUp & VolumeDown -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="🔊 音量 +" Tag="VolumeUp" Click="SelectRemoteButton" Height="34" Margin="3"/>
                                        <Button Grid.Column="1" Content="🔉 音量 −" Tag="VolumeDown" Click="SelectRemoteButton" Height="34" Margin="3"/>
                                    </Grid>

                                    <!-- Passthrough Notice Card -->
                                    <Border Background="#1C1E22" BorderBrush="#333740" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="2,4,2,0">
                                        <TextBlock Text="ℹ️ OK、方向键与背面全键盘保持系统原生输入" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" TextAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                        <TextBlock Text="按键快速选择" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="清除设置" Padding="8,6" Margin="8,0,0,0"
                                    Command="{Binding ClearSelectedMappingCommand}"/>
                            <ComboBox ItemsSource="{Binding CurrentMappings}" SelectedItem="{Binding SelectedMapping}"
                                      AutomationProperties.Name="正在编辑的按键" DisplayMemberPath="ButtonName"/>
                        </DockPanel>
                    </StackPanel>
                    <TabControl DataContext="{Binding SelectedMapping}" Background="Transparent" BorderThickness="0">
                        <TabItem Header="单击">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ContentControl Content="{Binding SingleClick}" ContentTemplate="{StaticResource GestureEditor}"/>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="长按">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ContentControl Content="{Binding LongPress}" ContentTemplate="{StaticResource GestureEditor}"/>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="双击">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ContentControl Content="{Binding DoubleClick}" ContentTemplate="{StaticResource GestureEditor}"/>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
