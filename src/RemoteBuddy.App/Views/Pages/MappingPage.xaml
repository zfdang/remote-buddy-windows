<UserControl x:Class="RemoteBuddy.App.Views.Pages.MappingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:model="clr-namespace:RemoteBuddy.Core.Models;assembly=RemoteBuddy.Core"
             xmlns:vm="clr-namespace:RemoteBuddy.App.ViewModels"
             xmlns:converters="clr-namespace:RemoteBuddy.App.Converters">
    <UserControl.Resources>
        <converters:MappingButtonStatusConverter x:Key="MappingButtonStatusConverter"/>
        <Storyboard x:Key="RemoteButtonPress" FillBehavior="Stop">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.88"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.12" Value="0.88"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.26" Value="1"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.88"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.12" Value="0.88"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.26" Value="1"/>
            </DoubleAnimationUsingKeyFrames>
            <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(Control.BorderBrush).(SolidColorBrush.Color)">
                <DiscreteColorKeyFrame KeyTime="0:0:0" Value="#4DA6FF"/>
                <DiscreteColorKeyFrame KeyTime="0:0:0.26" Value="#4DA6FF"/>
            </ColorAnimationUsingKeyFrames>
        </Storyboard>

        <Style x:Key="GestureSelectorButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="True">
                    <Setter Property="Background" Value="#007ACC"/>
                    <Setter Property="BorderBrush" Value="#0098FF"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="Tag" Value="False">
                    <Setter Property="Background" Value="#2D3036"/>
                    <Setter Property="BorderBrush" Value="#3E4249"/>
                    <Setter Property="Foreground" Value="#CCCCCC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="GestureEditor">
            <StackPanel Margin="0,10,0,0">
                <TextBlock Text="{Binding Help}" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <ComboBox ItemsSource="{Binding AvailableActions}" SelectedItem="{Binding Action, Mode=TwoWay}"
                          AutomationProperties.Name="动作类型" Margin="0,0,0,12">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource EnumToDisplayNameConverter}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <StackPanel Visibility="{Binding Action, Converter={StaticResource EqualValueToVisibilityConverter}, ConverterParameter=KeyboardShortcut}">
                    <TextBlock Text="键盘快捷键" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                    <DockPanel Margin="0,0,0,8">
                        <ToggleButton DockPanel.Dock="Right" Margin="8,0,0,0" Padding="8,5" ToolTip="按 Esc 取消录制"
                                      InputMethod.IsInputMethodEnabled="False"
                                      PreviewKeyDown="RecordShortcut" LostKeyboardFocus="StopRecordingShortcut">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Content" Value="录制"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="Content" Value="请按快捷键"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                        <TextBox Text="{Binding Shortcut, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 AutomationProperties.Name="键盘快捷键" Padding="8,5"/>
                    </DockPanel>
                    <TextBlock Text="{Binding ShortcutValidationError}" Foreground="#FF6666" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                               Visibility="{Binding HasShortcutError, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <TextBlock Text="常用按键与组合快捷键" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{x:Static vm:MappingGestureViewModel.ShortcutPresets}" DisplayMemberPath="Key"
                              SelectionChanged="ApplyShortcutPreset" AutomationProperties.Name="常用快捷键"/>
                </StackPanel>
                <StackPanel Visibility="{Binding Action, Converter={StaticResource EqualValueToVisibilityConverter}, ConverterParameter=MediaControl}">
                    <TextBlock Text="媒体操作" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{x:Static vm:MappingGestureViewModel.AvailableMediaCommands}"
                              SelectedItem="{Binding Media, Mode=TwoWay}" AutomationProperties.Name="媒体操作">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumToDisplayNameConverter}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <StackPanel Visibility="{Binding Action, Converter={StaticResource EqualValueToVisibilityConverter}, ConverterParameter=TextSnippet}">
                    <TextBlock Text="常用短语" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             AutomationProperties.Name="常用短语" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="65" Padding="8,5"/>
                </StackPanel>
                <StackPanel Visibility="{Binding Action, Converter={StaticResource EqualValueToVisibilityConverter}, ConverterParameter=ContinuousRepeat}">
                    <Border Background="#1E2024" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,4,0,0">
                        <TextBlock Text="🔄 持续连发模式：按住此键时将以约 100 毫秒间隔重复触发【单击】动作，松开即停。"
                                   Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                    </Border>
                    <Border Background="#3D2E18" BorderBrush="#8A5A1A" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,8,0,0"
                            Visibility="{Binding ShowRepeatNeedsClickWarning, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="⚠️ 当前未配置【单击】动作，持续连发不会触发任何操作。请先为【单击】设置快捷键、媒体控制或短语。"
                                   Foreground="#FFB347" FontSize="12" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <DockPanel>
        <!-- Page Header -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="按键映射" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                <TextBlock Text="{Binding DeviceNote}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="{Binding HasDevices, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="遥控器" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" DisplayMemberPath="Name" Width="170" Margin="0,0,14,0"
                          PreviewMouseDown="FlushFocusedInput"/>
                <CheckBox Content="启用自定义按键" IsChecked="{Binding CustomMappingEnabled}" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Bottom Footer: RawInput Status & Selection Lock & Reset Defaults -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,16,0,0"
                Visibility="{Binding HasDevices, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <WrapPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="按实体遥控器查看按键反馈" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" Margin="0,0,14,0"/>
                    <CheckBox Content="锁定当前按键" ToolTip="按实体键时不自动切换选择" IsChecked="{Binding IsMappingSelectionLocked}"
                              Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                </WrapPanel>
                <Button Grid.Column="1" Content="恢复所有按键的默认映射" Padding="12,6" VerticalAlignment="Center"
                        Background="#382326" BorderBrush="#D07578" Foreground="#FFD0D0"
                        Click="ConfirmResetAllMappings"/>
            </Grid>
        </Border>

        <!-- Workspace / Empty State Wrapper -->
        <Grid>
            <!-- Empty State Card when no remotes are configured -->
            <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" Padding="36" CornerRadius="8" VerticalAlignment="Center"
                    Visibility="{Binding HasDevices, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
                <StackPanel HorizontalAlignment="Center" MaxWidth="420">
                    <TextBlock Text="🎮" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="尚未配置遥控器" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="请先添加并配对蓝牙遥控器，完成后即可在此为每个实体按键独立设置单击、长按和双击快捷动作。" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,20"/>
                    <Button Content="➕ 添加遥控器" Padding="18,9" Background="#007ACC" HorizontalAlignment="Center"
                            Command="{Binding AddDeviceCommand}"/>
                </StackPanel>
            </Border>

            <!-- Main 2-Column Mapping Workspace -->
            <Grid Visibility="{Binding HasDevices, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column: Visual Remote & Button Selector -->
            <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="实体遥控器按键" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                        <WrapPanel>
                            <TextBlock Text="● 已配置" Foreground="#83D8C4" Margin="0,0,10,0"/>
                            <TextBlock Text="● 未配置" Foreground="#AAB1BE" Margin="0,0,10,0"/>
                            <TextBlock Text="● 当前选择" Foreground="#88C5FF"/>
                        </WrapPanel>
                    </StackPanel>

                    <!-- Visual Remote Control Body -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="RemoteButtons" HorizontalAlignment="Center">
                            <StackPanel.Resources>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform/>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Background" Value="#292D35"/>
                                    <Setter Property="BorderBrush" Value="#455060"/>
                                    <Setter Property="Foreground" Value="#AAB1BE"/>
                                    <Setter Property="AutomationProperties.ItemStatus">
                                        <Setter.Value>
                                            <MultiBinding Converter="{StaticResource MappingButtonStatusConverter}">
                                                <Binding Path="Tag" RelativeSource="{RelativeSource Self}"/>
                                                <Binding Path="SelectedMapping.Button"/>
                                                <Binding Path="CurrentMappings"/>
                                                <Binding Path="CurrentMappings.Count"/>
                                                <Binding Path="MappingRevision"/>
                                            </MultiBinding>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="AutomationProperties.ItemStatus" Value="已配置">
                                            <Setter Property="Background" Value="#203C3A"/>
                                            <Setter Property="BorderBrush" Value="#41776B"/>
                                            <Setter Property="Foreground" Value="#C1F4E7"/>
                                        </Trigger>
                                        <Trigger Property="AutomationProperties.ItemStatus" Value="当前选择">
                                            <Setter Property="Background" Value="#1D4E7C"/>
                                            <Setter Property="BorderBrush" Value="#88C5FF"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                        <Trigger Property="AutomationProperties.ItemStatus" Value="语音键">
                                            <Setter Property="Background" Value="#223344"/>
                                            <Setter Property="BorderBrush" Value="#466A8D"/>
                                            <Setter Property="Foreground" Value="#A9D7FF"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Resources>
                            <!-- 1. Xiaomi Remote Control Body -->
                            <Border Background="#242629" BorderBrush="#3E4249" BorderThickness="1" CornerRadius="28" Padding="14,10" Width="210"
                                    Visibility="{Binding IsXiaomi, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <!-- Top Row: Power & Voice -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="⏻ 电源" Tag="Power" Click="SelectRemoteButton"
                                                Height="36" Margin="4,0"/>
                                        <Button Grid.Column="1" Content="🎙️ 语音" Tag="Voice" Click="SelectRemoteButton"
                                                Height="36" Margin="4,0"
                                                ToolTip="语音键由【输入法集成】配置全局生效"/>
                                    </Grid>

                                    <!-- Directional Ring (D-Pad) -->
                                    <Border Background="#1C1D20" BorderBrush="#383B42" BorderThickness="1" CornerRadius="64" Width="128" Height="128" Margin="0,0,0,8">
                                        <Grid>
                                            <Button Content="▲" Tag="Up" Click="SelectRemoteButton"
                                                    HorizontalAlignment="Center" VerticalAlignment="Top" Width="38" Height="30" Margin="0,5,0,0"/>
                                            <Button Content="▼" Tag="Down" Click="SelectRemoteButton"
                                                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Width="38" Height="30" Margin="0,0,0,5"/>
                                            <Button Content="◀" Tag="Left" Click="SelectRemoteButton"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center" Width="30" Height="38" Margin="5,0,0,0"/>
                                            <Button Content="▶" Tag="Right" Click="SelectRemoteButton"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center" Width="30" Height="38" Margin="0,0,5,0"/>
                                            <Button Content="OK" Tag="Ok" Click="SelectRemoteButton"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center" Width="46" Height="46"
                                                    FontWeight="Bold"/>
                                        </Grid>
                                    </Border>

                                    <!-- Navigation Keys Grid -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="34"/>
                                            <RowDefinition Height="34"/>
                                            <RowDefinition Height="34"/>
                                        </Grid.RowDefinitions>
                                        <Button Grid.Row="0" Grid.Column="0" Content="↩ 返回" Tag="Back" Click="SelectRemoteButton" Margin="3"/>
                                        <Button Grid.Row="0" Grid.Column="1" Content="🔊 音量 +" Tag="VolumeUp" Click="SelectRemoteButton" Margin="3"/>
                                        <Button Grid.Row="1" Grid.Column="0" Content="⌂ 主页" Tag="Home" Click="SelectRemoteButton" Margin="3"/>
                                        <Button Grid.Row="1" Grid.Column="1" Content="🔉 音量 −" Tag="VolumeDown" Click="SelectRemoteButton" Margin="3"/>
                                        <Button Grid.Row="2" Grid.Column="0" Content="≡ 菜单" Tag="Menu" Click="SelectRemoteButton" Margin="3"/>
                                        <Button Grid.Row="2" Grid.Column="1" Content="📺 电视 / TV" Tag="LiveTv" Click="SelectRemoteButton" Margin="3"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <!-- 2. Google Chromecast G9N9N Remote Body -->
                            <Border Background="#242629" BorderBrush="#3E4249" BorderThickness="1" CornerRadius="28" Padding="14,10" Width="210"
                                    Visibility="{Binding IsG9N9NLayout, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <!-- Directional Ring (D-Pad) -->
                                    <Border Background="#1C1D20" BorderBrush="#383B42" BorderThickness="1" CornerRadius="64" Width="128" Height="128" Margin="0,0,0,8">
                                        <Grid>
                                            <Button Content="▲" Tag="Up" Click="SelectRemoteButton"
                                                    HorizontalAlignment="Center" VerticalAlignment="Top" Width="38" Height="30" Margin="0,5,0,0"/>
                                            <Button Content="▼" Tag="Down" Click="SelectRemoteButton"
                                                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Width="38" Height="30" Margin="0,0,0,5"/>
                                            <Button Content="◀" Tag="Left" Click="SelectRemoteButton"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center" Width="30" Height="38" Margin="5,0,0,0"/>
                                            <Button Content="▶" Tag="Right" Click="SelectRemoteButton"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center" Width="30" Height="38" Margin="0,0,5,0"/>
                                            <Button Content="OK" Tag="Ok" Click="SelectRemoteButton"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center" Width="46" Height="46"
                                                    FontWeight="Bold"/>
                                        </Grid>
                                    </Border>

                                    <!-- Middle Controls: Back & Voice -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="↩ 返回" Tag="Back" Click="SelectRemoteButton" Height="32" Margin="3"/>
                                        <Button Grid.Column="1" Content="🎙️ 语音" Tag="Voice" Click="SelectRemoteButton" Height="32" Margin="3"

                                                ToolTip="短按免提、长按松手即停"/>
                                    </Grid>

                                    <!-- Home & Mute -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="⌂ 主页" Tag="Home" Click="SelectRemoteButton" Height="32" Margin="3"/>
                                        <Button Grid.Column="1" Content="🔇 静音" Tag="Mute" Click="SelectRemoteButton" Height="32" Margin="3"/>
                                    </Grid>

                                    <!-- YouTube & Netflix App Keys -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="▶ YouTube" Tag="YouTube" Click="SelectRemoteButton" Height="32" Margin="3"/>
                                        <Button Grid.Column="1" Content="N Netflix" Tag="Netflix" Click="SelectRemoteButton" Height="32" Margin="3"/>
                                    </Grid>

                                    <!-- Bottom: Power & Input -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="⏻ 电源" Tag="Power" Click="SelectRemoteButton" Height="32" Margin="3"/>
                                        <Button Grid.Column="1" Content="📺 输入源" Tag="Input" Click="SelectRemoteButton" Height="32" Margin="3"/>
                                    </Grid>

                                    <!-- Side Volume Buttons -->
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="🔊 音量 +" Tag="VolumeUp" Click="SelectRemoteButton" Height="30" Margin="3"/>
                                        <Button Grid.Column="1" Content="🔉 音量 −" Tag="VolumeDown" Click="SelectRemoteButton" Height="30" Margin="3"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 2b. Google TV Streamer (GY3LE) Remote Body -->
                            <Border Background="#242629" BorderBrush="#3E4249" BorderThickness="1" CornerRadius="28" Padding="14,10" Width="210"
                                    Visibility="{Binding IsGY3LELayout, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <!-- Directional Ring (D-Pad) -->
                                    <Border Background="#1C1D20" BorderBrush="#383B42" BorderThickness="1" CornerRadius="64" Width="128" Height="128" Margin="0,0,0,8">
                                        <Grid>
                                            <Button Content="▲" Tag="Up" Click="SelectRemoteButton"
                                                    HorizontalAlignment="Center" VerticalAlignment="Top" Width="38" Height="30" Margin="0,5,0,0"/>
                                            <Button Content="▼" Tag="Down" Click="SelectRemoteButton"
                                                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Width="38" Height="30" Margin="0,0,0,5"/>
                                            <Button Content="◀" Tag="Left" Click="SelectRemoteButton"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center" Width="30" Height="38" Margin="5,0,0,0"/>
                                            <Button Content="▶" Tag="Right" Click="SelectRemoteButton"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center" Width="30" Height="38" Margin="0,0,5,0"/>
                                            <Button Content="OK" Tag="Ok" Click="SelectRemoteButton"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center" Width="46" Height="46"
                                                    FontWeight="Bold"/>
                                        </Grid>
                                    </Border>

                                    <!-- Row 1: Back & Home -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="↩ 返回" Tag="Back" Click="SelectRemoteButton" Height="32" Margin="3"/>
                                        <Button Grid.Column="1" Content="⌂ 主页" Tag="Home" Click="SelectRemoteButton" Height="32" Margin="3"/>
                                    </Grid>

                                    <!-- Row 2: Voice & Mute -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="🎙️ 语音" Tag="Voice" Click="SelectRemoteButton" Height="32" Margin="3"
                                                ToolTip="短按免提、长按松手即停"/>
                                        <Button Grid.Column="1" Content="🔇 静音" Tag="Mute" Click="SelectRemoteButton" Height="32" Margin="3"/>
                                    </Grid>

                                    <!-- Row 3: YouTube & Netflix -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="▶ YouTube" Tag="YouTube" Click="SelectRemoteButton" Height="32" Margin="3"/>
                                        <Button Grid.Column="1" Content="N Netflix" Tag="Netflix" Click="SelectRemoteButton" Height="32" Margin="3"/>
                                    </Grid>

                                    <!-- Row 4: Power & Custom (Star) -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="⏻ 电源" Tag="Power" Click="SelectRemoteButton" Height="32" Margin="3"/>
                                        <Button Grid.Column="1" Content="★ 自定义" Tag="Custom" Click="SelectRemoteButton" Height="32" Margin="3"/>
                                    </Grid>

                                    <!-- VolumeUp & VolumeDown -->
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="🔊 音量 +" Tag="VolumeUp" Click="SelectRemoteButton" Height="30" Margin="3"/>
                                        <Button Grid.Column="1" Content="🔉 音量 −" Tag="VolumeDown" Click="SelectRemoteButton" Height="30" Margin="3"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 3. T1 Remote Control Body -->
                            <Border Background="#242629" BorderBrush="#3E4249" BorderThickness="1" CornerRadius="28" Padding="14,10" Width="210"
                                    Visibility="{Binding IsT1, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <!-- Top Row: Power & Voice -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="⏻ 电源" Tag="Power" Click="SelectRemoteButton"
                                                Height="36" Margin="4,0"/>
                                        <Button Grid.Column="1" Content="🎙️ 语音" Tag="Voice" Click="SelectRemoteButton"
                                                Height="36" Margin="4,0"
                                                ToolTip="T1 语音键按一下开启、再按一下结束"/>
                                    </Grid>

                                    <!-- Front Row 1: Back & Home -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="↩ 返回" Tag="Back" Click="SelectRemoteButton" Height="34" Margin="3"/>
                                        <Button Grid.Column="1" Content="⌂ 主页" Tag="Home" Click="SelectRemoteButton" Height="34" Margin="3"/>
                                    </Grid>

                                    <!-- Front Row 2: Menu & Mute -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="≡ 菜单" Tag="Menu" Click="SelectRemoteButton" Height="34" Margin="3"/>
                                        <Button Grid.Column="1" Content="🔇 静音" Tag="Mute" Click="SelectRemoteButton" Height="34" Margin="3"/>
                                    </Grid>

                                    <!-- Front Row 3: VolumeUp & VolumeDown -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="🔊 音量 +" Tag="VolumeUp" Click="SelectRemoteButton" Height="34" Margin="3"/>
                                        <Button Grid.Column="1" Content="🔉 音量 −" Tag="VolumeDown" Click="SelectRemoteButton" Height="34" Margin="3"/>
                                    </Grid>

                                    <!-- Passthrough Notice Card -->
                                    <Border Background="#1C1E22" BorderBrush="#333740" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="2,4,2,0">
                                        <TextBlock Text="ℹ️ OK、方向键与背面全键盘保持系统原生输入" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" TextAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <DockPanel>
                    <!-- Top: Button Quick Select & Clear -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="按键快速选择" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="清除当前按键" Padding="10,6" Margin="8,0,0,0"
                                    Command="{Binding ClearSelectedMappingCommand}"/>
                            <ComboBox ItemsSource="{Binding CurrentMappings}" SelectedItem="{Binding SelectedMapping}"
                                      AutomationProperties.Name="正在编辑的按键" DisplayMemberPath="ButtonName"/>
                        </DockPanel>
                    </StackPanel>

                    <!-- Status Bar: Displays single click, long press, double click current values at a glance -->
                    <Border DockPanel.Dock="Top" Background="#24262A" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="当前按键设置状态 (一览)：" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="2,0,0,6"/>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Single Click Status Chip -->
                                <Border Grid.Column="0" Background="#1D1F23" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="4" Padding="6,5"
                                        Cursor="Hand" ToolTip="点击切换到单击设置" MouseLeftButtonDown="SelectSingleClickFromStatus">
                                    <StackPanel>
                                        <TextBlock Text="👆 单击" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                        <TextBlock Text="{Binding SelectedMapping.SingleClickSummary, FallbackValue='未配置'}"
                                                   FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                                   Foreground="{Binding SelectedMapping.SingleClick.IsConfigured, Converter={StaticResource BoolToConfiguredBrushConverter}}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Long Press Status Chip -->
                                <Border Grid.Column="2" Background="#1D1F23" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="4" Padding="6,5"
                                        Cursor="Hand" ToolTip="点击切换到长按设置" MouseLeftButtonDown="SelectLongPressFromStatus">
                                    <StackPanel>
                                        <TextBlock Text="⏱️ 长按" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                        <TextBlock Text="{Binding SelectedMapping.LongPressSummary, FallbackValue='未配置'}"
                                                   FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                                   Foreground="{Binding SelectedMapping.LongPress.IsConfigured, Converter={StaticResource BoolToConfiguredBrushConverter}}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Double Click Status Chip -->
                                <Border Grid.Column="4" Background="#1D1F23" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="4" Padding="6,5"
                                        Cursor="Hand" ToolTip="点击切换到双击设置" MouseLeftButtonDown="SelectDoubleClickFromStatus">
                                    <StackPanel>
                                        <TextBlock Text="✌️ 双击" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                        <TextBlock Text="{Binding SelectedMapping.DoubleClickSummary, FallbackValue='未配置'}"
                                                   FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                                   Foreground="{Binding SelectedMapping.DoubleClick.IsConfigured, Converter={StaticResource BoolToConfiguredBrushConverter}}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Gesture Selector Buttons: Separate buttons to set SingleClick, LongPress, or DoubleClick -->
                    <Border DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="👆 单击设置" Padding="0,7"
                                    PreviewMouseDown="FlushFocusedInput"
                                    Command="{Binding SelectTriggerCommand}" CommandParameter="SingleClick"
                                    Style="{StaticResource GestureSelectorButtonStyle}"
                                    Tag="{Binding SelectedTrigger, Converter={StaticResource EqualValueToBoolConverter}, ConverterParameter=SingleClick}"/>
                            <Button Grid.Column="2" Content="⏱️ 长按设置" Padding="0,7"
                                    PreviewMouseDown="FlushFocusedInput"
                                    Command="{Binding SelectTriggerCommand}" CommandParameter="LongPress"
                                    Style="{StaticResource GestureSelectorButtonStyle}"
                                    Tag="{Binding SelectedTrigger, Converter={StaticResource EqualValueToBoolConverter}, ConverterParameter=LongPress}"/>
                            <Button Grid.Column="4" Content="✌️ 双击设置" Padding="0,7"
                                    PreviewMouseDown="FlushFocusedInput"
                                    Command="{Binding SelectTriggerCommand}" CommandParameter="DoubleClick"
                                    Style="{StaticResource GestureSelectorButtonStyle}"
                                    Tag="{Binding SelectedTrigger, Converter={StaticResource EqualValueToBoolConverter}, ConverterParameter=DoubleClick}"/>
                        </Grid>
                    </Border>

                    <!-- Active Gesture Editor -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ContentControl Content="{Binding ActiveGesture}" ContentTemplate="{StaticResource GestureEditor}"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
