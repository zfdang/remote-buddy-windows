<UserControl x:Class="RemoteBuddy.App.Views.Pages.MappingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RemoteBuddy.App.Views.Controls"
             xmlns:models="clr-namespace:RemoteBuddy.Core.Models;assembly=RemoteBuddy.Core">
    <DockPanel>
        <!-- Top Header Bar -->
        <Border DockPanel.Dock="Top" Padding="0,0,0,14" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="按键映射" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                        <CheckBox Content="自定义按键"
                                  IsChecked="{Binding CustomMappingEnabled, Mode=TwoWay}"
                                  Foreground="{StaticResource PrimaryTextBrush}"
                                  FontSize="13.5" FontWeight="Medium"
                                  Margin="16,2,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding DeviceNote}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12.5" Margin="0,5,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding HasDevices, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="遥控器" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="DeviceSelectorComboBox"
                              ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" DisplayMemberPath="Name"
                              Width="220"
                              Focusable="False" IsTabStop="False"
                              PreviewMouseDown="OnDeviceSelectorPreviewMouseDown"
                              PreviewKeyDown="OnDeviceSelectorPreviewKeyDown"
                              SelectionChanged="OnDeviceSelectorSelectionChanged"
                              DropDownClosed="OnDeviceSelectorDropDownClosed">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Focusable" Value="False"/>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Workspace / Empty State Wrapper -->
        <Grid Margin="0,14,0,0">
            <!-- Empty State Card -->
            <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1"
                    Padding="36" CornerRadius="10" VerticalAlignment="Center"
                    Visibility="{Binding HasDevices, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
                <StackPanel HorizontalAlignment="Center" MaxWidth="420">
                    <TextBlock Text="🎮" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="尚未配置遥控器" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="请先添加并配对蓝牙遥控器，完成后即可在此为每个实体按键独立设置单击、双击和长按动作。"
                               FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,20"/>
                    <Button Content="➕ 添加遥控器" Padding="18,9" Background="#007ACC" BorderBrush="#0098FF" HorizontalAlignment="Center"
                            Command="{Binding AddDeviceCommand}"/>
                </StackPanel>
            </Border>

            <!-- Scrollable Mapping Workspace -->
            <ScrollViewer x:Name="PageScrollViewer" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasDevices, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Margin="0,0,4,16">
                    <!-- Model-specific Notice -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10"
                                Visibility="{Binding IsG9N9N, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="支持标准系统 HID 与蓝牙事件补全（ETW）双重捕获，详见" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource HeaderLinkButtonStyle}" Content="设备指南 ↗" FontSize="12" Padding="4,0"
                                Command="{Binding OpenDeviceGuideCommand}"/>
                    </StackPanel>
                    <TextBlock Text="T1 背面全键盘、确认键与方向键默认直通系统原生输入，正面 7 颗功能键可自由映射。"
                               FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,10" TextWrapping="Wrap"
                               Visibility="{Binding IsT1, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <!-- Visual Remote Mapping Canvas -->
                    <Border Background="#23252A" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,14">
                        <controls:RemoteMappingCanvasControl x:Name="MappingCanvasControl"/>
                    </Border>

                    <!-- Inline Action Editor Panel (Opens when clicking a trigger chip) -->
                    <Border x:Name="ActionEditorCard" Background="{StaticResource CardBackgroundBrush}" BorderBrush="#3399FF" BorderThickness="1.5"
                            CornerRadius="12" Padding="18" Margin="0,0,0,14"
                            Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <!-- Editor Header -->
                            <DockPanel LastChildFill="True" Margin="0,0,0,12">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="恢复此项默认" Padding="10,5" Margin="0,0,8,0"
                                            Visibility="{Binding CanRestoreEditingDefault, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Command="{Binding RestoreDefaultActionCommand}"
                                            ToolTip="将当前触发条件的动作恢复为出厂默认设置"/>
                                    <Button Content="清除设置" Padding="10,5" Margin="0,0,8,0"
                                            Command="{Binding ClearEditingActionCommand}"
                                            ToolTip="将当前手势设为不执行任何动作"/>
                                    <Button Content="完成" Padding="12,5" Background="#007ACC" BorderBrush="#0098FF"
                                            Command="{Binding CloseEditorCommand}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding EditingButtonDisplayName}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                    <Border Background="#1D3E5E" BorderBrush="#337AB7" BorderThickness="1" CornerRadius="12" Padding="10,3" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding EditingTriggerDisplayName}" FontSize="12.5" FontWeight="SemiBold" Foreground="#7BC3FF"/>
                                    </Border>
                                </StackPanel>
                            </DockPanel>

                            <!-- Not-set helper -->
                            <TextBlock Text="当前手势不执行任何动作；该按键的其他手势不受影响。选择下方动作即可立即保存。"
                                       FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,10" TextWrapping="Wrap"
                                       Visibility="{Binding IsEditingDisabled, Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <!-- Direct Passthrough Lock Notice -->
                            <Border Background="#1B2B3F" BorderBrush="#2F5987" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8"
                                    Visibility="{Binding IsDirectPassthroughLockActive, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="ℹ️ 当前按键的「单击」已设置为「按键直通」，按下时立即发送原生按键、松开时立即结束，不支持双击与长按手势。"
                                           FontSize="12.5" Foreground="#A9D7FF" TextWrapping="Wrap"/>
                            </Border>

                            <!-- Long Press Hold-Repeat Option -->
                            <StackPanel Margin="0,0,0,12"
                                        Visibility="{Binding ShowLongPressHoldRepeatOption, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Button Command="{Binding SelectHoldRepeatCommand}" HorizontalContentAlignment="Left" Padding="12,9">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Background" Value="#25272C"/>
                                            <Setter Property="BorderBrush" Value="#3E4249"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHoldRepeatSelected}" Value="True">
                                                    <Setter Property="Background" Value="#1B3C5E"/>
                                                    <Setter Property="BorderBrush" Value="#3399FF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔄 持续连发" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,8,0"/>
                                        <TextBlock Text="✓ 已选中" FontSize="12" FontWeight="SemiBold" Foreground="#4DA6FF" VerticalAlignment="Center"
                                                   Visibility="{Binding IsHoldRepeatSelected, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="长按选择“持续连发”时，按住约 0.35 秒后重复执行单击动作，松开即停；也可以选择下方其他动作，长按时只执行一次。"
                                           FontSize="11.5" Foreground="{StaticResource SecondaryTextBrush}" Margin="2,6,0,0" TextWrapping="Wrap"/>
                                <Border Background="#3D2E18" BorderBrush="#8A5A1A" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,8,0,0"
                                        Visibility="{Binding ShowRepeatNeedsClickWarning, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="⚠️ 当前未配置可连发的「单击」动作，持续连发不会触发任何操作。"
                                               FontSize="12" Foreground="#FFB347" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>

                            <!-- Category Filter & Action Grid -->
                            <StackPanel Visibility="{Binding ShowCategoryGrid, Converter={StaticResource BoolToVisibilityConverter}}">
                                <!-- Category Pills -->
                                <Border Background="#202226" BorderBrush="#34373D" BorderThickness="1" CornerRadius="10" Padding="6" Margin="0,0,0,12">
                                    <ItemsControl ItemsSource="{Binding VisibleCategories}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding Title}" Margin="3,0" Padding="8,8" FontSize="13"
                                                        Click="OnCategoryButtonClick" Tag="{Binding Category}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Setter Property="BorderBrush" Value="#3E4249"/>
                                                            <Setter Property="Foreground" Value="#BBBBBB"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Background" Value="#007ACC"/>
                                                                    <Setter Property="BorderBrush" Value="#3399FF"/>
                                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>

                                <!-- Action Options Grid -->
                                <ItemsControl ItemsSource="{Binding VisibleActionOptions}" Margin="0,0,0,10">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="3"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Margin="0,0,8,8" Padding="10,7" HorizontalContentAlignment="Stretch"
                                                    IsEnabled="{Binding IsAvailable}"
                                                    Click="OnActionOptionClick" Tag="{Binding Action}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Setter Property="Background" Value="#25272C"/>
                                                        <Setter Property="BorderBrush" Value="#3C4048"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Background" Value="#1B3C5E"/>
                                                                <Setter Property="BorderBrush" Value="#3399FF"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <DockPanel LastChildFill="True">
                                                    <Border DockPanel.Dock="Right" Background="#1D1F23" CornerRadius="4" Padding="6,2" Margin="6,0,0,0"
                                                            Visibility="{Binding HasShortcutBadge, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBlock Text="{Binding ShortcutBadge}" FontSize="11" Foreground="#A6ADB9"/>
                                                    </Border>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="✓" FontSize="12" FontWeight="Bold" Foreground="#4DA6FF" Margin="0,0,6,0"
                                                                   Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                        <TextBlock Text="○" FontSize="11" Foreground="#7A818D" Margin="0,0,6,0"
                                                                   Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}"/>
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="12.5" Foreground="{StaticResource PrimaryTextBrush}"
                                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Direct Passthrough Help Callout -->
                                <Border Background="#1B2B3F" BorderBrush="#2F5987" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10"
                                        Visibility="{Binding ShowDirectPassthroughHelp, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="ℹ️ 按下时立即发送按键，松开时立即结束。适合观看视频时按住开启倍速播放，不支持双击与长按手势。"
                                               FontSize="12.5" Foreground="#A9D7FF" TextWrapping="Wrap"/>
                                </Border>

                                <!-- Common Phrases Quick Entry Tile -->
                                <Border Margin="0,0,0,10"
                                        Visibility="{Binding ShowCommonPhrasesAdjustTile, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Button Content="⚙️ 前往调整常用语库与按键分配…" Padding="12,8" HorizontalAlignment="Left"
                                            Command="{Binding OpenCommonPhrasesCommand}"/>
                                </Border>

                                <!-- Inline Editor: Text Snippet -->
                                <Border Background="#23252A" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10"
                                        Visibility="{Binding ShowTextSnippetEditor, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="直接输入的短语内容" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                                        <TextBox Text="{Binding SnippetInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" Padding="8,6"/>
                                    </StackPanel>
                                </Border>

                                <!-- Inline Editor: Custom Shortcut -->
                                <Border Background="#23252A" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10"
                                        Visibility="{Binding ShowCustomShortcutEditor, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel>
                                        <DockPanel LastChildFill="True" Margin="0,0,0,8">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button Content="选择快捷键…" Padding="10,6" Margin="0,0,8,0" Click="OpenShortcutPickerDialog"/>
                                                <ToggleButton x:Name="RecordShortcutToggle" Padding="10,6" Margin="0,0,8,0"
                                                              InputMethod.IsInputMethodEnabled="False"
                                                              Checked="OnRecordShortcutChecked"
                                                              PreviewKeyDown="RecordShortcut" PreviewKeyUp="RecordShortcutKeyUp"
                                                              LostKeyboardFocus="StopRecordingShortcut">
                                                    <ToggleButton.Style>
                                                        <Style TargetType="ToggleButton">
                                                            <Setter Property="Content" Value="直接录入"/>
                                                            <Setter Property="Background" Value="#3E3E42"/>
                                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                                            <Setter Property="BorderBrush" Value="#555555"/>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter Property="Content" Value="请按下快捷键…"/>
                                                                    <Setter Property="Background" Value="#007ACC"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ToggleButton.Style>
                                                </ToggleButton>
                                                <Button Content="清除" Padding="10,6"
                                                        IsEnabled="{Binding HasCustomShortcutValue}"
                                                        Command="{Binding ClearCustomShortcutCommand}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding CustomShortcutDisplay}" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <TextBox Text="{Binding CustomShortcutInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Padding="8,5" ToolTip="也可直接输入如 Ctrl+C、Win+Tab、RAlt"/>
                                        <TextBlock Text="{Binding ShortcutValidationError}" Foreground="#FF6666" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                                                   Visibility="{Binding HasShortcutError, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Inline Editor: Open URL / URL Scheme -->
                                <Border Background="#23252A" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10"
                                        Visibility="{Binding ShowOpenUrlEditor, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="目标网址或 URL Scheme" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                                        <TextBox Text="{Binding UrlInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Padding="8,6" Margin="0,0,0,6"
                                                 ToolTip="例如 https://example.com 或 ms-settings:bluetooth"/>
                                        <TextBlock Text="请输入有效的网址或 URL Scheme（支持 https://、http:// 或自定义协议如 ms-settings:、obsidian://）。"
                                                   FontSize="12" Foreground="#FF6666" Margin="0,0,0,8" TextWrapping="Wrap"
                                                   Visibility="{Binding ShowInvalidUrlHint, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <TextBlock Text="{Binding UrlTestFeedback}" FontSize="12" Foreground="#FFB347" Margin="0,0,0,8" TextWrapping="Wrap"
                                                   Visibility="{Binding HasUrlTestFeedback, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <DockPanel LastChildFill="False">
                                            <Button DockPanel.Dock="Left" Content="填入系统设置示例" Padding="10,5"
                                                    Command="{Binding ApplySettingsUrlTemplateCommand}"/>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button Content="清除" Padding="10,5" Margin="0,0,8,0"
                                                        IsEnabled="{Binding HasUrlInput}"
                                                        Command="{Binding ClearUrlCommand}"/>
                                                <Button Content="测试打开" Padding="12,5" Background="#007ACC" BorderBrush="#0098FF"
                                                        IsEnabled="{Binding IsUrlValid}"
                                                        Command="{Binding TestOpenUrlCommand}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Inline Editor: Custom Application -->
                                <Border Background="#23252A" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10"
                                        Visibility="{Binding ShowCustomApplicationEditor, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="目标应用程序" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,8"/>
                                        <WrapPanel Margin="0,0,0,8">
                                            <ItemsControl ItemsSource="{Binding CustomApplications}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,8,6">
                                                            <Button Content="{Binding DisplayName}" Padding="10,6" Click="OnSelectCustomAppClick" Tag="{Binding Id}"
                                                                    ToolTip="{Binding ExecutablePath}">
                                                                <Button.Style>
                                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                                        <Setter Property="Background" Value="#2A2D33"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                <Setter Property="Background" Value="#1B3C5E"/>
                                                                                <Setter Property="BorderBrush" Value="#3399FF"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>
                                                            <Button Content="✕" Padding="6,6" Margin="2,0,0,0" Click="OnDeleteCustomAppClick" Tag="{Binding Id}"
                                                                    ToolTip="移除此应用配置"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Button Content="＋ 选择应用程序 (.exe)…" Padding="10,6" Margin="0,0,0,6" Click="ChooseCustomApplication"/>
                                        </WrapPanel>

                                        <StackPanel Visibility="{Binding HasSelectedCustomApplication, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Border Height="1" Background="{StaticResource BorderColorBrush}" Margin="0,4,0,10"/>
                                            <TextBlock Text="切入后聚焦方式" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <RadioButton Content="仅激活应用窗口" GroupName="CustomAppFocus"
                                                             IsChecked="{Binding IsCustomAppNoneStrategy, Mode=OneWay}"
                                                             Click="OnSelectCustomAppStrategyNone"
                                                             Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,18,0"/>
                                                <RadioButton Content="切入后发送聚焦快捷键" GroupName="CustomAppFocus"
                                                             IsChecked="{Binding IsCustomAppShortcutStrategy, Mode=OneWay}"
                                                             Click="OnSelectCustomAppStrategyShortcut"
                                                             Foreground="{StaticResource PrimaryTextBrush}"/>
                                            </StackPanel>

                                            <DockPanel LastChildFill="True" Margin="0,0,0,8"
                                                       Visibility="{Binding IsCustomAppShortcutStrategy, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Button DockPanel.Dock="Right" Content="清除" Padding="10,5" Margin="8,0,0,0"
                                                        IsEnabled="{Binding HasCustomAppFocusShortcut}"
                                                        Command="{Binding ClearCustomAppFocusShortcutCommand}"/>
                                                <TextBox Text="{Binding CustomAppFocusShortcutInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Padding="8,5" ToolTip="例如 Ctrl+L、Ctrl+K"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding CustomAppShortcutError}" Foreground="#FF6666" FontSize="12" Margin="0,0,0,6"
                                                       Visibility="{Binding HasCustomAppShortcutError, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                            <DockPanel LastChildFill="False">
                                                <Button DockPanel.Dock="Right" Content="测试打开" Padding="12,5" Background="#007ACC" BorderBrush="#0098FF"
                                                        Command="{Binding TestCustomApplicationCommand}"/>
                                            </DockPanel>
                                        </StackPanel>

                                        <TextBlock Text="请点击“选择应用程序 (.exe)…”添加一个应用。" FontSize="12" Foreground="#FFB347"
                                                   Visibility="{Binding HasSelectedCustomApplication, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Bottom Trigger Timing Hint -->
                            <TextBlock Text="{Binding TriggerTimingHint}" FontSize="12" TextWrapping="Wrap"
                                       Visibility="{Binding HasTriggerTimingHint, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTriggerTimingWarning}" Value="True">
                                                <Setter Property="Foreground" Value="#FFB347"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Footer Status & Selection Lock & Common Phrases -->
                    <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="⌨️" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding MappingStatusText}" FontSize="12.5" Foreground="{StaticResource SecondaryTextBrush}"/>
                            </StackPanel>
                            <Border Height="1" Background="{StaticResource BorderColorBrush}" Margin="0,0,0,10"/>
                            <DockPanel LastChildFill="True">
                                <Button DockPanel.Dock="Right" Content="📝 调整常用语" Padding="12,6" VerticalAlignment="Center"
                                        Command="{Binding OpenCommonPhrasesCommand}"/>
                                <StackPanel VerticalAlignment="Center">
                                    <CheckBox Content="锁定当前按键" IsChecked="{Binding IsMappingSelectionLocked}"
                                              Foreground="{StaticResource PrimaryTextBrush}" FontSize="12.5" FontWeight="Medium"/>
                                    <TextBlock Text="按实体遥控器时保持当前编辑项，不自动切换选中按键。" FontSize="11.5"
                                               Foreground="{StaticResource SecondaryTextBrush}" Margin="20,2,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Reset All Defaults Card -->
                    <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="10" Padding="16,12">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="↺ 恢复所有按键的默认设置" Padding="12,6" VerticalAlignment="Center"
                                    Background="#382326" BorderBrush="#D07578" Foreground="#FFD0D0"
                                    Click="ConfirmResetAllMappings"/>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="恢复所有按键默认设置" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                <TextBlock Text="将当前遥控器的所有按键单击、双击、长按及自定义快捷键全部恢复为出厂默认设置。"
                                           FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
