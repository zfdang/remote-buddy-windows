<UserControl x:Class="RemoteBuddy.App.Views.Pages.GeneralPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,24">
            <!-- Header -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="通用" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                <TextBlock Text="系统概览、状态检查与常规偏好设置" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Card 1: Overview Status Cards -->
            <TextBlock Text="当前状态检查" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,10"/>
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Status Card 1: Permissions & Driver -->
                <Border Grid.Column="0" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Top">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Background="#333338" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="1" FontSize="11" FontWeight="Bold" Foreground="#0098FF"/>
                                </Border>
                                <TextBlock Text="权限与驱动" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding PermissionsSummary}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        </StackPanel>
                        <Button DockPanel.Dock="Bottom" Content="进入检查 →" HorizontalAlignment="Left" Padding="12,5" FontSize="12"
                                Command="{Binding GoToPermissionsCommand}"/>
                    </DockPanel>
                </Border>

                <!-- Status Card 2: Remote Connection -->
                <Border Grid.Column="2" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Top">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Background="#333338" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="2" FontSize="11" FontWeight="Bold" Foreground="#0098FF"/>
                                </Border>
                                <TextBlock Text="遥控器连接" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding RemoteSummary}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        </StackPanel>
                        <Button DockPanel.Dock="Bottom" Content="管理设备 →" HorizontalAlignment="Left" Padding="12,5" FontSize="12"
                                Command="{Binding GoToDevicesCommand}"/>
                    </DockPanel>
                </Border>

                <!-- Status Card 3: Input Tool Integration -->
                <Border Grid.Column="4" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Top">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Background="#333338" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="3" FontSize="11" FontWeight="Bold" Foreground="#0098FF"/>
                                </Border>
                                <TextBlock Text="输入法集成" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding IntegrationSummary}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        </StackPanel>
                        <Button DockPanel.Dock="Bottom" Content="配置快捷键 →" HorizontalAlignment="Left" Padding="12,5" FontSize="12"
                                Command="{Binding GoToIntegrationsCommand}"/>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Card 2: Setup Wizard Banner -->
            <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,18">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" MaxWidth="560">
                        <TextBlock Text="设置向导" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                        <TextBlock Text="重新运行首次配置向导，从头逐步完成麦克风驱动检查、蓝牙遥控器连接测试与目标输入法快捷键验证。"
                                   FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                    <Button Content="🚀 重新运行向导" DockPanel.Dock="Right" VerticalAlignment="Center" Padding="16,9" Background="#007ACC"
                            Command="{Binding RerunWizardCommand}"/>
                </DockPanel>
            </Border>

            <!-- Card 3: Preferences -->
            <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel>
                    <TextBlock Text="常规偏好" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,14"/>
                    <CheckBox Content="开机时自动在后台启动 Remote Buddy" IsChecked="{Binding LaunchAtStartup}" Foreground="#FFF" Margin="0,0,0,14"/>
                    <CheckBox Content="关闭主窗口时最小化至系统通知区域 (托盘)" IsChecked="{Binding MinimizeToTrayOnClose, Mode=TwoWay}" Foreground="#FFF"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
