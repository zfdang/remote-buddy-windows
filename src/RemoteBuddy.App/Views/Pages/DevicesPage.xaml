<UserControl x:Class="RemoteBuddy.App.Views.Pages.DevicesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:RemoteBuddy.App.Converters">
    <DockPanel>
        <!-- Page Header -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock Text="设备连接" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                <TextBlock Text="管理已添加的蓝牙遥控器"
                           Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="HeaderDeviceGuideLinkButton"
                        Style="{StaticResource HeaderLinkButtonStyle}"
                        Content="设备对比与选购指南 ↗"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0"
                        Command="{Binding OpenDeviceGuideCommand}"
                        ToolTip="https://remote.zfdang.com/device.html"
                        AutomationProperties.Name="设备对比与选购指南"/>
                <Button Content="➕ 添加新设备" Padding="14,8" Background="#007ACC" VerticalAlignment="Center"
                        Command="{Binding AddDeviceCommand}"/>
            </StackPanel>
        </Grid>

        <!-- Connection Failure Banner -->
        <Border DockPanel.Dock="Top" Background="#3D2E18" BorderBrush="#8A5A1A" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,14"
                Visibility="{Binding HasConnectionFeedback, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding ConnectionFeedbackMessage}" Foreground="#FFD480" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
                <Button Grid.Column="1" Content="✕" Padding="8,4" Background="Transparent" BorderBrush="#8A5A1A" Foreground="#FFD480" VerticalAlignment="Center"
                        Command="{Binding DismissConnectionFeedbackCommand}"/>
            </Grid>
        </Border>

        <!-- Device Cards List -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Empty State Card -->
                <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" Margin="0,0,0,16" Padding="32" CornerRadius="8"
                        Visibility="{Binding HasDevices, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🎮" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="暂未配置遥控器" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="请点击上方「➕ 添加新设备」运行向导，配对遥控器并完成按键和语音测试。" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,18" TextAlignment="Center"/>
                        <Button Content="➕ 运行添加设备向导" Padding="16,8" Background="#007ACC" HorizontalAlignment="Center"
                                Command="{Binding AddDeviceCommand}"/>
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding DiscoveredDevices}"
                              Visibility="{Binding HasDevices, Converter={StaticResource BoolToVisibilityConverter}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" Margin="0,0,0,16" Padding="20" CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left Column: Device Identity & Action Buttons -->
                                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                    <!-- Device Header Box -->
                                    <Border Background="#252A30" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                                        <DockPanel>
                                            <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                                                     Fill="{Binding IsConnected, Converter={StaticResource BoolToBrushConverter}}"/>
                                            <TextBlock Text="{Binding Name, FallbackValue='未知遥控器'}" FontWeight="SemiBold" FontSize="14"
                                                       Foreground="{StaticResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis">
                                                <TextBlock.ToolTip>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}"/>
                                                        <TextBlock Text="{Binding IsConnected, Converter={StaticResource BoolToConnectionTextConverter}}"/>
                                                    </StackPanel>
                                                </TextBlock.ToolTip>
                                            </TextBlock>
                                        </DockPanel>
                                    </Border>

                                    <!-- Visual Remote Illustration -->
                                    <Border Background="#1A1D20" CornerRadius="10" BorderBrush="#333740" BorderThickness="1" Height="160" Margin="0,0,0,14" Padding="6">
                                        <Image Source="{Binding IllustrationSource}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Action Buttons aligned with macOS -->
                                    <!-- If Connected: Reconnect / Disconnect row, then Delete -->
                                    <StackPanel Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="🔌 断开" Padding="6,6" Background="#333842" BorderBrush="#4A5260"
                                                    ToolTip="断开当前蓝牙语音服务"
                                                    Command="{Binding DataContext.DisconnectDeviceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Grid.Column="2" Content="🔄 重连" Padding="6,6" Background="#007ACC"
                                                    ToolTip="重新建立蓝牙语音连接"
                                                    Command="{Binding DataContext.ReconnectDeviceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                        <Button Content="🗑️ 删除设备" Padding="12,6" Background="Transparent" BorderBrush="#663333" Foreground="#FF6666"
                                                Command="{Binding DataContext.RemoveDeviceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>

                                    <!-- If Disconnected: Connect, then Delete -->
                                    <StackPanel Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
                                        <Button Content="⚡ 连接设备" Margin="0,0,0,8" Padding="12,7" Background="#007ACC"
                                                Command="{Binding DataContext.ConnectDeviceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="🗑️ 删除设备" Padding="12,6" Background="Transparent" BorderBrush="#663333" Foreground="#FF6666"
                                                Command="{Binding DataContext.RemoveDeviceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Divider -->
                                <Border Grid.Column="1" Background="{StaticResource BorderColorBrush}"/>

                                <!-- Right Column: Audio Gain & Device Details -->
                                <StackPanel Grid.Column="2" Margin="22,0,0,0">
                                    <!-- Microphone Gain -->
                                    <TextBlock Text="麦克风输入增益 (Gain)" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Minimum="1.0" Maximum="15.8" Value="{Binding Gain, Mode=TwoWay}"
                                                TickFrequency="1.0" IsSnapToTickEnabled="False" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Gain, Converter={StaticResource GainToDbTextConverter}}"
                                                   FontFamily="Consolas" FontSize="13" Foreground="#00CC66"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="根据说话音量调节输入增益；默认推荐 0 dB ~ 12 dB。" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                                    <Border Height="1" Background="{StaticResource BorderColorBrush}" Margin="0,0,0,16"/>

                                    <!-- G9N9N Voice Button Mode Section -->
                                    <Border Background="#22252A" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,16"
                                            Visibility="{Binding IsG9N9N, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="语音键触发方式 (Voice Button Mode)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,8"/>
                                            <WrapPanel Margin="0,0,0,8">
                                                <RadioButton Content="智能切换 (Smart Toggle)" IsChecked="{Binding IsSmartToggleMode}" GroupName="{Binding Id}"
                                                             Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                                <RadioButton Content="按住说话 (Hold to Talk)" IsChecked="{Binding IsHoldToTalkMode}" GroupName="{Binding Id}"
                                                             Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                            </WrapPanel>
                                            <TextBlock Text="{Binding VoiceModeHelp}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Hardware Usage Guide Section -->
                                    <!-- 1. G9N9N Guide -->
                                    <Border Background="#1F2328" BorderBrush="#333740" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16"
                                            Visibility="{Binding IsG9N9NLayout, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="💡 硬件使用提示 (G9N9N)" FontSize="12" FontWeight="SemiBold" Foreground="#88CCFF" Margin="0,0,0,6"/>
                                            <TextBlock Text="• 底部白色指示灯常亮表示正在传输语音，停止后自动熄灭。" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                            <TextBlock Text="• 智能切换与按住说话均支持连续保活，最长 5 分钟安全停麦以防耗电。" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                            <TextBlock Text="• 智能切换免提收音期间，若按其他实体键会结束收音。" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 1b. GY3LE Guide -->
                                    <Border Background="#1F2328" BorderBrush="#333740" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16"
                                            Visibility="{Binding IsGY3LELayout, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="💡 硬件使用提示 (Google TV Streamer · GY3LE)" FontSize="12" FontWeight="SemiBold" Foreground="#88CCFF" Margin="0,0,0,6"/>
                                            <TextBlock Text="• 配有独立的自定义星标键 (★)，可在【按键映射】中自由配置快捷操作。" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                            <TextBlock Text="• 智能切换与按住说话均支持连续保活，最长 5 分钟安全停麦以防耗电。" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                            <TextBlock Text="• 智能切换免提收音期间，若按其他实体键会结束收音。" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 2. T1 Guide -->
                                    <Border Background="#1F2328" BorderBrush="#333740" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16"
                                            Visibility="{Binding IsT1, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="💡 硬件使用提示 (T1 Remote)" FontSize="12" FontWeight="SemiBold" Foreground="#88CCFF" Margin="0,0,0,6"/>
                                            <TextBlock Text="• 点按免提收音：按一下语音键开始说话、再按一次停止（约 5 分钟安全上限）。" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                            <TextBlock Text="• 自动兼容按住说话输入法：收音期间系统自动维持按住状态，无需持续按住遥控器。" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                            <TextBlock Text="• 原生直通：确认、方向键、飞鼠与背面 QWERTY 全键盘无需映射即可直接输入打字。" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 3. Xiaomi Guide -->
                                    <Border Background="#1F2328" BorderBrush="#333740" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16"
                                            Visibility="{Binding IsXiaomi, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="💡 硬件使用提示 (小米遥控器)" FontSize="12" FontWeight="SemiBold" Foreground="#88CCFF" Margin="0,0,0,6"/>
                                            <TextBlock Text="• 仅支持按住说话：按住语音键说话、松开立即停麦（硬件固件松手即停止推送音频）。" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Height="1" Background="{StaticResource BorderColorBrush}" Margin="0,0,0,16"/>

                                    <TextBlock Text="设备详情" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,12"/>
                                    <Grid>
                                        <Grid.Resources>
                                            <Style x:Key="DetailLabel" TargetType="TextBlock">
                                                <Setter Property="FontSize" Value="12"/>
                                                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                                                <Setter Property="Margin" Value="0,0,16,0"/>
                                            </Style>
                                            <Style x:Key="DetailValue" TargetType="TextBlock">
                                                <Setter Property="FontSize" Value="12"/>
                                                <Setter Property="FontWeight" Value="Medium"/>
                                                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                            </Style>
                                        </Grid.Resources>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="型号" Style="{StaticResource DetailLabel}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ModelDisplayName}" Style="{StaticResource DetailValue}"/>
                                        <TextBlock Grid.Row="1" Text="蓝牙地址" Style="{StaticResource DetailLabel}" Margin="0,8,16,0"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FormattedAddress}" FontFamily="Consolas" Style="{StaticResource DetailValue}" Margin="0,8,0,0"/>
                                        <TextBlock Grid.Row="2" Text="电量" Style="{StaticResource DetailLabel}" Margin="0,8,16,0"
                                                   Visibility="{Binding BatteryLevel, Converter={StaticResource BatteryVisibilityConverter}}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding BatteryLevel, StringFormat='{}{0}%'}" Style="{StaticResource DetailValue}" Margin="0,8,0,0"
                                                   Visibility="{Binding BatteryLevel, Converter={StaticResource BatteryVisibilityConverter}}"/>
                                        <TextBlock Grid.Row="3" Text="硬件型号" Style="{StaticResource DetailLabel}" Margin="0,8,16,0"
                                                   Visibility="{Binding HardwareInformation.ModelNumber, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Collapsed}"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding HardwareInformation.ModelNumber}" Style="{StaticResource DetailValue}" Margin="0,8,0,0"
                                                   Visibility="{Binding HardwareInformation.ModelNumber, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Collapsed}"/>
                                        <TextBlock Grid.Row="4" Text="厂商 / 产品 ID" Style="{StaticResource DetailLabel}" Margin="0,8,16,0"
                                                   Visibility="{Binding HardwareInformation.VendorProductId, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Collapsed}"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding HardwareInformation.VendorProductId}" Style="{StaticResource DetailValue}" Margin="0,8,0,0"
                                                   Visibility="{Binding HardwareInformation.VendorProductId, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Collapsed}"/>
                                        <TextBlock Grid.Row="5" Text="固件版本" Style="{StaticResource DetailLabel}" Margin="0,8,16,0"
                                                   Visibility="{Binding HardwareInformation.FirmwareRevision, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Collapsed}"/>
                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding HardwareInformation.FirmwareRevision}" Style="{StaticResource DetailValue}" Margin="0,8,0,0"
                                                   Visibility="{Binding HardwareInformation.FirmwareRevision, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Collapsed}"/>
                                        <TextBlock Grid.Row="6" Text="语音协议" Style="{StaticResource DetailLabel}" Margin="0,8,16,0"
                                                   Visibility="{Binding HardwareInformation.VoiceProtocol, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Collapsed}"/>
                                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding HardwareInformation.VoiceProtocol}" Style="{StaticResource DetailValue}" Margin="0,8,0,0"
                                                   Visibility="{Binding HardwareInformation.VoiceProtocol, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Collapsed}"/>
                                        <TextBlock Grid.Row="7" Text="音频格式" Style="{StaticResource DetailLabel}" Margin="0,8,16,0"
                                                   Visibility="{Binding HardwareInformation.AudioFormat, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Collapsed}"/>
                                        <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding HardwareInformation.AudioFormat}" Style="{StaticResource DetailValue}" Margin="0,8,0,0"
                                                   Visibility="{Binding HardwareInformation.AudioFormat, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Collapsed}"/>
                                        <TextBlock Grid.Row="8" Text="音频帧大小" Style="{StaticResource DetailLabel}" Margin="0,8,16,0"
                                                   Visibility="{Binding HardwareInformation.AudioFrameSize, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Collapsed}"/>
                                        <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding HardwareInformation.AudioFrameSize}" Style="{StaticResource DetailValue}" Margin="0,8,0,0"
                                                   Visibility="{Binding HardwareInformation.AudioFrameSize, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Collapsed}"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
