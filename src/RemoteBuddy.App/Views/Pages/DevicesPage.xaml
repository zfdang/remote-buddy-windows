<UserControl x:Class="RemoteBuddy.App.Views.Pages.DevicesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:RemoteBuddy.App.Converters">
    <DockPanel>
        <!-- Page Header -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="设备连接" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                <TextBlock Text="管理已配对或已发现的蓝牙遥控器。选择设备并连接：" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="{Binding IsScanning, Converter={StaticResource BoolToScanTextConverter}, FallbackValue='🔍 扫描设备'}"
                        Margin="0,0,10,0" Padding="14,8"
                        Command="{Binding ToggleScanCommand}"/>
                <Button Content="➕ 添加新设备" Margin="0,0,10,0" Padding="14,8" Background="#007ACC"
                        Command="{Binding AddDeviceCommand}"/>
                <Button Content="⚡ 重启蓝牙" Padding="14,8"
                        Command="{Binding RestartBluetoothCommand}"
                        ToolTip="重启本地蓝牙适配器硬件，使 ETW 内核驱动脱敏规则立即生效（建议以管理员身份运行）"/>
            </StackPanel>
        </Grid>

        <!-- Current Active Device Banner -->
        <Border DockPanel.Dock="Top" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,18">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Margin="0,0,10,0"
                             Fill="{Binding IsConnected, Converter={StaticResource BoolToBrushConverter}}"/>
                    <TextBlock Text="当前状态：" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13"/>
                    <TextBlock Text="{Binding ConnectedDeviceName}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" FontSize="13" Margin="4,0,14,0"/>
                    <TextBlock Text="·  " Foreground="{StaticResource SecondaryTextBrush}" FontSize="13"/>
                    <TextBlock Text="🎙️ " FontSize="13"/>
                    <TextBlock Text="{Binding VoiceIntegrationSummary}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Device Cards List -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Empty State Card -->
                <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" Margin="0,0,0,16" Padding="32" CornerRadius="8"
                        Visibility="{Binding HasDevices, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🎮" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="暂未配置遥控器" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="请点击上方「➕ 添加新设备」运行向导，配对遥控器并完成按键和语音测试。" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,18" TextAlignment="Center"/>
                        <Button Content="➕ 运行添加设备向导" Padding="16,8" Background="#007ACC" HorizontalAlignment="Center"
                                Command="{Binding AddDeviceCommand}"/>
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding DiscoveredDevices}"
                              Visibility="{Binding HasDevices, Converter={StaticResource BoolToVisibilityConverter}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" Margin="0,0,0,16" Padding="20" CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left Column: Device Identity & Action Buttons -->
                                <StackPanel Grid.Column="0" Margin="0,0,20,0" Width="220">
                                    <!-- Device Header Box -->
                                    <Border Background="#252A30" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name, FallbackValue='未知遥控器'}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource PrimaryTextBrush}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding ModelDisplayName}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,2,0,4" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="8" Height="8" Margin="0,0,6,0"
                                                         Fill="{Binding IsConnected, Converter={StaticResource BoolToBrushConverter}}"/>
                                                <TextBlock Text="{Binding IsConnected, Converter={StaticResource BoolToConnectionTextConverter}}"
                                                           FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                <TextBlock Text="{Binding BatteryLevel, StringFormat=' · 🔋 {0}%'}" FontSize="12" Foreground="#00CC66" Margin="4,0,0,0"
                                                           Visibility="{Binding BatteryLevel, Converter={StaticResource BatteryVisibilityConverter}}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Visual Remote Illustration -->
                                    <Border Background="#1A1D20" CornerRadius="10" BorderBrush="#333740" BorderThickness="1" Height="160" Margin="0,0,0,14" Padding="6">
                                        <Image Source="{Binding IllustrationSource}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Action Buttons aligned with macOS -->
                                    <!-- If Connected: Reconnect / Disconnect row, then Delete -->
                                    <StackPanel Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="🔌 断开" Padding="6,6" Background="#333842" BorderBrush="#4A5260"
                                                    ToolTip="断开当前蓝牙语音服务"
                                                    Command="{Binding DataContext.DisconnectDeviceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Grid.Column="2" Content="🔄 重连" Padding="6,6" Background="#007ACC"
                                                    ToolTip="重新建立蓝牙语音连接"
                                                    Command="{Binding DataContext.ReconnectDeviceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                        <Button Content="🗑️ 删除设备" Padding="12,6" Background="Transparent" BorderBrush="#663333" Foreground="#FF6666"
                                                Command="{Binding DataContext.RemoveDeviceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>

                                    <!-- If Disconnected: Connect, then Delete -->
                                    <StackPanel Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
                                        <Button Content="⚡ 连接设备" Margin="0,0,0,8" Padding="12,7" Background="#007ACC"
                                                Command="{Binding DataContext.ConnectDeviceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="🗑️ 删除设备" Padding="12,6" Background="Transparent" BorderBrush="#663333" Foreground="#FF6666"
                                                Command="{Binding DataContext.RemoveDeviceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Divider -->
                                <Border Grid.Column="1" Background="{StaticResource BorderColorBrush}"/>

                                <!-- Right Column: Audio Gain & Device Details -->
                                <StackPanel Grid.Column="2" Margin="22,0,0,0">
                                    <!-- Microphone Gain -->
                                    <TextBlock Text="麦克风输入增益 (Gain)" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Minimum="1.0" Maximum="15.8" Value="{Binding Gain, Mode=TwoWay}"
                                                TickFrequency="1.0" IsSnapToTickEnabled="False" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Gain, Converter={StaticResource GainToDbTextConverter}}"
                                                   FontFamily="Consolas" FontSize="13" Foreground="#00CC66"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="根据说话音量调节输入增益；默认推荐 0 dB ~ 12 dB。" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,16"/>

                                    <Border Height="1" Background="{StaticResource BorderColorBrush}" Margin="0,0,0,16"/>

                                    <!-- G9N9N Voice Button Mode Section -->
                                    <Border Background="#22252A" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,16"
                                            Visibility="{Binding IsG9N9N, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="语音键触发方式 (Voice Button Mode)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,8"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <RadioButton Content="智能切换 (Smart Toggle)" IsChecked="{Binding IsSmartToggleMode}" GroupName="{Binding Id}"
                                                             Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                                <RadioButton Content="按住说话 (Hold to Talk)" IsChecked="{Binding IsHoldToTalkMode}" GroupName="{Binding Id}"
                                                             Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding VoiceModeHelp}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Hardware Usage Guide Section -->
                                    <!-- 1. G9N9N Guide -->
                                    <Border Background="#1F2328" BorderBrush="#333740" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16"
                                            Visibility="{Binding IsG9N9N, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="💡 硬件使用提示 (G9N9N)" FontSize="12" FontWeight="SemiBold" Foreground="#88CCFF" Margin="0,0,0,6"/>
                                            <TextBlock Text="• 底部白色指示灯常亮表示正在传输语音，停止后自动熄灭。" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                            <TextBlock Text="• 智能切换与按住说话均支持连续保活，最长 5 分钟安全停麦以防耗电。" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                            <TextBlock Text="• 智能切换免提收音期间，若按其他实体键会结束收音。" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 2. T1 Guide -->
                                    <Border Background="#1F2328" BorderBrush="#333740" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16"
                                            Visibility="{Binding IsT1, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="💡 硬件使用提示 (T1 Remote)" FontSize="12" FontWeight="SemiBold" Foreground="#88CCFF" Margin="0,0,0,6"/>
                                            <TextBlock Text="• 点按免提收音：按一下语音键开始说话、再按一次停止（约 5 分钟安全上限）。" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                            <TextBlock Text="• 自动兼容按住说话输入法：收音期间系统自动维持按住状态，无需持续按住遥控器。" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                            <TextBlock Text="• 原生直通：确认、方向键、飞鼠与背面 QWERTY 全键盘无需映射即可直接输入打字。" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 3. Xiaomi Guide -->
                                    <Border Background="#1F2328" BorderBrush="#333740" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16"
                                            Visibility="{Binding IsXiaomi, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="💡 硬件使用提示 (小米遥控器)" FontSize="12" FontWeight="SemiBold" Foreground="#88CCFF" Margin="0,0,0,6"/>
                                            <TextBlock Text="• 仅支持按住说话：按住语音键说话、松开立即停麦（硬件固件松手即停止推送音频）。" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Height="1" Background="{StaticResource BorderColorBrush}" Margin="0,0,0,16"/>

                                    <!-- Technical Device Info Grid (3-Column Layout Aligned with macOS) -->
                                    <TextBlock Text="设备详细信息" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,12"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Row 0: Model / MAC / Firmware -->
                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,14,14">
                                            <TextBlock Text="设备型号 (Model)" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                                            <TextBlock Text="{Binding ModelDisplayName}" FontSize="12" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="Medium" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,14,14">
                                            <TextBlock Text="蓝牙地址 (MAC)" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                                            <TextBlock Text="{Binding FormattedAddress}" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="Medium" Margin="0,3,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,14">
                                            <TextBlock Text="固件版本 (Firmware)" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                                            <TextBlock Text="{Binding FirmwareVersion}" FontSize="12" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="Medium" Margin="0,3,0,0"/>
                                        </StackPanel>

                                        <!-- Row 1: Voice Protocol / Audio Spec / Frame Size -->
                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,14,14">
                                            <TextBlock Text="语音通信协议" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                                            <TextBlock Text="{Binding VoiceProtocol}" FontSize="12" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="Medium" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,14,14">
                                            <TextBlock Text="音频编码规格" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                                            <TextBlock Text="{Binding AudioSpec}" FontSize="12" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="Medium" Margin="0,3,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,14">
                                            <TextBlock Text="传输帧长 (Frame)" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                                            <TextBlock Text="{Binding FrameSizeText}" FontSize="12" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="Medium" Margin="0,3,0,0"/>
                                        </StackPanel>

                                        <!-- Row 2: Input Architecture / Virtual Audio / Container ID -->
                                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,14,0">
                                            <TextBlock Text="输入链路机制" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                                            <TextBlock Text="{Binding InputArchitecture}" FontSize="12" Foreground="#00CC66" FontWeight="Medium" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,14,0">
                                            <TextBlock Text="虚拟麦克风端点" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                                            <TextBlock Text="{Binding VirtualAudioEndpoint}" FontSize="12" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="Medium" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,0">
                                            <TextBlock Text="Windows 容器标识" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                                            <TextBlock Text="{Binding ContainerId, TargetNullValue='自动匹配中...'}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
